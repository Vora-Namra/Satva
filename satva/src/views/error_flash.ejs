<script>
  function showFlash(message, type = "error") {
    // 1. Define Tailwind classes based on the type (error or success)
    const isError = type === "error";
    const bgClass = isError ? "bg-red-50" : "bg-green-50";
    const textClass = isError ? "text-red-800" : "text-green-800";
    const borderClass = isError ? "border-red-300" : "border-green-300";
    const btnTextClass = isError ? "text-red-500" : "text-green-500";
    const btnHoverClass = isError ? "hover:bg-red-200" : "hover:bg-green-200";
    const btnFocusClass = isError
      ? "focus:ring-red-400"
      : "focus:ring-green-400";

    // 2. Create the container element
    const flashDiv = document.createElement("div");

    // Position it fixed at the top right, with initial styles for a fade-down animation
    flashDiv.className = `fixed top-6 right-6 z-[100] flex items-center justify-between p-4 mb-4 ${textClass} border ${borderClass} rounded-xl ${bgClass} shadow-lg transition-all duration-300 opacity-0 transform -translate-y-4 min-w-[300px] max-w-md`;
    flashDiv.setAttribute("role", "alert");

    // 3. Inject the HTML layout
    flashDiv.innerHTML = `
    <div class="flex items-center gap-3">
      <svg class="flex-shrink-0 w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
        <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
      </svg>
      <div class="text-sm font-semibold">
        ${message}
      </div>
    </div>
    <button type="button" class="ml-4 -mx-1.5 -my-1.5 ${bgClass} ${btnTextClass} rounded-lg focus:ring-2 ${btnFocusClass} p-1.5 ${btnHoverClass} inline-flex items-center justify-center h-8 w-8 transition-colors" aria-label="Close">
      <span class="sr-only">Close</span>
      <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
      </svg>
    </button>
  `;

    // 4. Append to the document body
    document.body.appendChild(flashDiv);

    // 5. Trigger the animation slightly after appending (to allow DOM to register the element)
    requestAnimationFrame(() => {
      flashDiv.classList.remove("opacity-0", "-translate-y-4");
      flashDiv.classList.add("opacity-100", "translate-y-0");
    });

    // 6. Function to handle removal
    const removeFlash = () => {
      flashDiv.classList.remove("opacity-100", "translate-y-0");
      flashDiv.classList.add("opacity-0", "-translate-y-4");

      // Wait for the transition duration (300ms) before removing from DOM
      setTimeout(() => {
        if (document.body.contains(flashDiv)) {
          flashDiv.remove();
        }
      }, 300);
    };

    // 7. Attach click event to the close button
    flashDiv.querySelector("button").addEventListener("click", removeFlash);

    // 8. Auto-dismiss after 4 seconds
    setTimeout(removeFlash, 4000);
  }

  function setFlash(message, type = "success") {
    const flashData = { message, type };
    sessionStorage.setItem("pendingFlash", JSON.stringify(flashData));
  }

  function checkFlash() {
    const pendingFlash = sessionStorage.getItem("pendingFlash");

    if (pendingFlash) {
      const { message, type } = JSON.parse(pendingFlash);

      // Show the alert
      showFlash(message, type);

      // Remove item from session storage so on next reload it will not be there
      sessionStorage.removeItem("pendingFlash");
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    checkFlash();
  });
</script>
