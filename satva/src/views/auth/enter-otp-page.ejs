  <%- include("../error_flash") %>

    <script>
      document.getElementById("menuBtn").addEventListener("click", () => {
        document.getElementById("mobileMenu").classList.toggle("hidden");
      });

      // Password toggles
      function makeToggle(btnId, inputId, iconId) {
        document.getElementById(btnId).addEventListener("click", () => {
          const input = document.getElementById(inputId);
          const icon = document.getElementById(iconId);
          const isPass = input.type === "password";
          input.type = isPass ? "text" : "password";
          icon.className = isPass
            ? "fa-regular fa-eye-slash text-sm"
            : "fa-regular fa-eye text-sm";
        });
      }
      makeToggle("toggleNew", "newPassword", "eyeNew");
      makeToggle("toggleConfirm", "confirm_password", "eyeConfirm");
      // Frontend validations

      document
        .getElementById("resetForm")
        .addEventListener("submit", async (e) => {
          e.preventDefault();
          const otpError = document.getElementById("otpError");
          const passwordError = document.getElementById("passwordError");
          const confirmError = document.getElementById("confirmError");
          const otp = document.getElementById("otp");
          const password = document.getElementById("newPassword");
          const confirmPassword = document.getElementById("confirm_password");
          function showError(input, errorId, message) {
            document.getElementById(errorId).textContent = message;
            document.getElementById(errorId).classList.remove("hidden");

            if (input) {
              input.classList.add("border-red-500");
            }

            isValid = false;
          }

          let isValid = true;
          [otp, password, confirmPassword].forEach((ele) => {
            ele.classList.remove("border-red-500");
          });
          [otpError, passwordError, confirmError].forEach((ele) => {
            ele.classList.add("hidden");
            ele.textContent = "";
          });

          if (otp.value.trim() == "") {
            showError(otp, "otpError", "OTP is required");
          } else if (!/^\d{6}$/.test(otp.value.trim())) {
            showError(otp, "otpError", "Enter valid OTP");
          }

          if (!password.value) {
            showError(password, "passwordError", "New password is required");
          } else if (
            !/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[#?!@$%^&*-]).{8,}$/.test(
              password.value,
            )
          ) {
            showError(
              password,
              "passwordError",
              "Password must contain uppercase, lowercase, number and special character",
            );
          }
          if (!confirmPassword.value) {
            showError(
              confirmPassword,
              "confirmError",
              "Confirm password is required",
            );
          } else if (
            !/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[#?!@$%^&*-]).{8,}$/.test(
              password.value,
            )
          ) {
            showError(
              confirmPassword,
              "confirmError",
              "Password must contain uppercase, lowercase, number and special character",
            );
          } else if (confirmPassword.value != password.value) {
            showError(confirmPassword, "confirmError", "Password do not match");
          }

          if (!isValid) {
            e.preventDefault();
            return;
          }
          const userTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
          let formData = new FormData(document.getElementById("resetForm"));
          let formEntries = Object.fromEntries(formData.entries());
          formEntries["timezone"] = userTimezone;
          let response = await fetch("/api/v1/auth/reset-password", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(formEntries),
          });

          let data = await response.json();

          if (response.ok) {
            // showMessage(data.message, false);
            setFlash(data.message, "success");
            window.location.href = "/";
          } else {
            showFlash(data.message, "error");
          }
        });
    </script>
</body>

