              </div>
              <p id="otpError" class="mt-1 text-sm text-red-500 hidden"></p>
            </div>

            <!-- New Password -->
            <div>
              <label for="newPassword" class="block text-sm font-semibold text-gray-700 mb-1.5">New Password</label>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400 pointer-events-none">
