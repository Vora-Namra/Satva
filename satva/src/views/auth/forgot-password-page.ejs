  <!-- ===== MAIN ===== -->
  <main class="flex-1 flex items-center justify-center pt-24 pb-16 px-4">
    <div class="w-full max-w-5xl animate-fadeUp">
      <div
        class="bg-white rounded-3xl shadow-xl border border-gray-100 overflow-hidden flex flex-col lg:flex-row min-h-[480px]">
        <!-- Left decorative panel -->
        <div class="relative bg-primary lg:w-2/5 flex flex-col justify-between p-10 overflow-hidden">
          <div class="hero-blob w-64 h-64 bg-emerald-300 -top-16 -right-16"></div>
          <div class="hero-blob w-48 h-48 bg-teal-700 bottom-0 -left-12"></div>
          <div class="panel-dots absolute inset-0"></div>

          <div class="relative z-10">
            <div
              class="inline-flex items-center gap-2 bg-white/15 backdrop-blur-sm text-white text-xs font-semibold px-4 py-1.5 rounded-full mb-8">
              <span class="w-2 h-2 rounded-full bg-white animate-pulse inline-block"></span>
              Account Recovery
            </div>
            <h2 class="font-display text-4xl font-bold text-white leading-tight mb-4">
              Reset Your<br />Password<br />Securely
            </h2>
            <p class="text-green-100 text-sm leading-relaxed max-w-xs">
              No worries — it happens to everyone. Enter your email and we'll
              send you a one-time code to regain access to your account.
            </p>
          </div>

          <!-- Info badges -->
          <div class="relative z-10 space-y-3 mt-8">
            <div class="flex items-center gap-3 bg-white/10 rounded-xl px-4 py-3">
              <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <span class="text-white text-xs font-medium">OTP sent to your email</span>
            </div>
            <div class="flex items-center gap-3 bg-white/10 rounded-xl px-4 py-3">
              <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
              <span class="text-white text-xs font-medium">End-to-end encrypted reset</span>
            </div>
            <div class="flex items-center gap-3 bg-white/10 rounded-xl px-4 py-3">
              <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <span class="text-white text-xs font-medium">HIPAA Compliant & Secure</span>
            </div>
          </div>
        </div>

        <!-- Right form panel -->
        <div class="flex-1 flex flex-col justify-center px-8 py-10 sm:px-12 animate-fadeUp-d1">
          <div class="mb-8">
            <h3 class="font-display text-3xl font-bold text-gray-900 mb-1">
              Forgot Password
            </h3>
            <p class="text-sm text-gray-500">
              Enter your registered email and we'll send you an OTP
            </p>
          </div>

          <!-- Toast notification -->
          <div id="toast" class="hidden mb-4 px-4 py-3 rounded-xl text-sm font-medium"></div>

          <form id="emailForm" class="space-y-5" novalidate>
            <!-- Email -->
            <div>
              <label for="email" class="block text-sm font-semibold text-gray-700 mb-1.5">Email Address</label>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400 pointer-events-none">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </span>
                <input id="email" name="email" type="email" placeholder="john@example.com" required
                  class="w-full pl-10 pr-4 py-3 text-sm border border-gray-200 rounded-xl bg-gray-50 placeholder-gray-400 transition" />
              </div>
              <p id="emailError" class="mt-1 text-sm text-red-500 hidden">
                Please enter a valid email address
              </p>
            </div>

            <!-- Submit -->
            <button id="submitBtn" type="submit"
              class="w-full py-3 px-4 bg-primary hover:bg-primary-dark text-white text-sm font-semibold rounded-xl shadow-md transition-all duration-200 mt-2 flex items-center justify-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
              Send OTP
            </button>

            <!-- Back to login -->
            <p class="text-sm text-gray-500 text-center">
              Remembered your password?
              <a href="/login" class="text-primary font-semibold hover:underline ml-1">Back to Login →</a>
            </p>
          </form>
        </div>
      </div>
    </div>
  </main>

  <!-- ===== FOOTER ===== -->
  <footer class="bg-[#0f1923] text-gray-400 py-10 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8 pb-8 border-b border-gray-700">
