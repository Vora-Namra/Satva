        </p>
      </div>
      <div>
        <h4 class="text-white text-sm font-semibold mb-3">Quick Links</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/" class="hover:text-primary transition">Home</a></li>
          <li>
            <a href="/doctors" class="hover:text-primary transition">Doctors</a>
          </li>
          <li>
            <a href="/about" class="hover:text-primary transition">About Us</a>
          </li>
          <li>
            <a href="/contact" class="hover:text-primary transition">Contact</a>
          </li>
        </ul>
      </div>
      <div>
        <h4 class="text-white text-sm font-semibold mb-3">Specialties</h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/doctors" class="hover:text-primary transition">Cardiology</a>
          </li>
          <li>
            <a href="/doctors" class="hover:text-primary transition">Neurology</a>
          </li>
          <li>
            <a href="/doctors" class="hover:text-primary transition">Dermatology</a>
          </li>
          <li>
            <a href="/doctors" class="hover:text-primary transition">Pediatrics</a>
          </li>
        </ul>
      </div>
      <div>
        <h4 class="text-white text-sm font-semibold mb-3">Contact</h4>
        <ul class="space-y-2 text-xs">
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2"
              viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            hello@satva.health
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2"
              viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            +91 98765 43210
          </li>
        </ul>
      </div>
    </div>
    <div
      class="max-w-5xl mx-auto pt-6 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-gray-600">
      <p>© 2026 Satva Health. All rights reserved.</p>
      <p>HIPAA Compliant · Secure & Encrypted</p>
    </div>
  </footer>
  <%- include("../error_flash") %>
    <script>
      document.getElementById("menuBtn").addEventListener("click", () => {
        document.getElementById("mobileMenu").classList.toggle("hidden");
      });

      const submitBtn = document.getElementById("submitBtn");

      if (submitBtn) {
        submitBtn.addEventListener("click", async (e) => {
          e.preventDefault();

          const emailInput = document.getElementById("email");
          const emailError = document.getElementById("emailError");
          const form = document.getElementById("emailForm");

          if (!emailInput || !form) {
            showToast("Form elements not found");
            return;
          }

          const email = emailInput.value.trim();
          emailError.classList.add("hidden");
          emailInput.classList.remove("border-red-500");

          if (!email) {
            emailError.textContent = "Please enter your email address";
            emailError.classList.remove("hidden");
            emailInput.classList.add("border-red-500");
            return;
          }

          if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            emailError.textContent = "Please enter a valid email address";
            emailError.classList.remove("hidden");
            emailInput.classList.add("border-red-500");
            return;
          }

          const formData = new FormData(form);
          const formEntries = Object.fromEntries(formData.entries());

          submitBtn.disabled = true;
          submitBtn.innerHTML = `<svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg> Sending…`;

          try {
            const response = await fetch("/api/v1/auth/sendOtp", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(formEntries),
            });

            const result = await response.json();

            if (response.ok) {
              // showToast(result.message || "OTP sent successfully", false);
              setFlash(result.message || "OTP send successfully");
              setTimeout(() => {
                window.location.href = "/show-email";
              }, 1000);
            } else {
              // showToast(result.message || "Failed to send OTP");
              showFlash(result.message || "Failed to send OTP", "error");

              submitBtn.disabled = false;
              submitBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg> Send OTP`;
            }
          } catch (error) {
            console.error(error);
            showFlash("Something went wrong. Please try again.");
            submitBtn.disabled = false;
            submitBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg> Send OTP`;
          }
        });
      }
    </script>
</body>

</html>