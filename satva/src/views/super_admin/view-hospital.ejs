<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Satva — View Hospital</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#10A37F",
                        "primary-dark": "#0d8a6a",
                        "primary-light": "#e6f7f3",
                        "bg-page": "#f0faf6",
                        dark: "#0f1923",
                    },
                    fontFamily: {
                        sans: ["'DM Sans'", "system-ui", "sans-serif"],
                        display: ["'Playfair Display'", "Georgia", "serif"],
                    },
                },
            },
        };
    </script>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        body { font-family: "DM Sans", sans-serif; }
    </style>
    <script type="module">
        import { checkSuperAdminJwt } from '/js/check-super-admin-jwt.js';
        checkSuperAdminJwt();
    </script>
</head>
<body class="bg-bg-page text-gray-800 min-h-screen flex flex-col">

    <!-- Navbar -->
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
        <div class="max-w-screen-2xl mx-auto px-6 py-4 flex items-center justify-between">
            <a href="/super-admin/dashboard" class="flex items-center gap-2.5">
                <div class="bg-primary rounded-lg p-1.5">
                    <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                </div>
                <span class="text-xl font-bold text-gray-900 font-display">Satva</span>
            </a>
            <div class="flex items-center gap-4">
                <a href="/super-admin/dashboard" class="text-sm font-semibold text-gray-600 hover:text-primary transition flex items-center gap-2">
                    <i class="fa-solid fa-arrow-left"></i>
                    Back to Dashboard
                </a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-1 max-w-3xl w-full mx-auto px-6 py-10">
        <div class="mb-8 flex justify-between items-center">
            <div class="flex items-center gap-4">
                <a href="/super-admin/dashboard" class="p-2 rounded-full hover:bg-gray-200 transition text-gray-600">
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
                <div>
                    <h2 class="text-2xl font-bold text-gray-800">Hospital Details</h2>
                    <p class="text-gray-500 text-sm mt-1">Viewing profile for <%= typeof hospital !== 'undefined' ? hospital.hospital_name : 'this hospital' %></p>
                </div>
            </div>
            <a href="/hospital/edit-hospital/<%= typeof hospital !== 'undefined' ? hospital.id : '1' %>" class="bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium py-2 px-4 rounded-lg shadow-sm transition flex items-center gap-2">
                <i class="fa-solid fa-pen"></i> Edit Hospital
            </a>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8">
            <div class="flex items-start gap-6 pb-6 border-b border-gray-100">
                <div class="w-20 h-20 rounded-xl bg-primary-light text-primary flex items-center justify-center text-3xl font-bold font-display flex-shrink-0 shadow-sm border border-primary/20">
                    <i class="fa-solid fa-hospital"></i>
                </div>
                <div>
                    <h3 class="text-2xl font-bold text-gray-900"><%= typeof hospital !== 'undefined' ? hospital.hospital_name : 'City General Hospital' %></h3>
                    <p class="text-gray-500 mt-1 flex items-center gap-2">
                        <i class="fa-solid fa-envelope w-4"></i> <%= typeof hospital !== 'undefined' ? hospital.email : 'contact@hospital.com' %>
                    </p>
                    <p class="text-gray-500 mt-1 flex items-center gap-2">
                        <i class="fa-solid fa-phone w-4"></i> <%= typeof hospital !== 'undefined' ? hospital.contact_number : '+1 234 567 8900' %>
                    </p>
                </div>
            </div>
            
            <div class="pt-6 grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-8">
                <div>
                    <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Hospital ID</h4>
                    <p class="text-gray-900 font-medium">#<%= typeof hospital !== 'undefined' ? hospital.id : '2048' %></p>
                </div>
                <div>
                    <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Registered On</h4>
                    <p class="text-gray-900 font-medium"><%= typeof hospital !== 'undefined' && hospital.createdAt ? new Date(hospital.createdAt).toLocaleDateString() : 'November 5, 2023' %></p>
                </div>
                <div class="md:col-span-2">
                    <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Primary Address</h4>
                    <p class="text-gray-900 font-medium"><%= typeof hospital !== 'undefined' ? hospital.address_line1 : '123 Healthcare Ave' %></p>
                    <p class="text-gray-500 text-sm mt-1"><%= typeof hospital !== 'undefined' && hospital.address_line2 ? hospital.address_line2 : '' %></p>
                </div>
            </div>
            
        </div>

        <div class="mt-8 bg-white rounded-xl shadow-sm border border-gray-100 p-8">
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-gray-100">
                <div>
                    <h3 class="text-xl font-bold text-gray-900">Hospital Administrators</h3>
                    <p class="text-sm text-gray-500 mt-1">Staff members managing this facility</p>
                </div>
            </div>

            <% if (typeof admins !== 'undefined' && admins.length > 0) { %>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider">
                                <th class="p-4 font-semibold rounded-tl-lg">Admin Name</th>
                                <th class="p-4 font-semibold">Email</th>
                                <th class="p-4 font-semibold">Role</th>
                                <th class="p-4 font-semibold rounded-tr-lg">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 text-sm">
                            <% admins.forEach(admin => { %>
                                <tr class="hover:bg-gray-50/50 transition">
                                    <td class="p-4 font-medium text-gray-900">
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-xs uppercase">
                                                <%= admin.first_name.charAt(0) %><%= admin.last_name.charAt(0) %>
                                            </div>
                                            <%= admin.first_name %> <%= admin.last_name %>
                                        </div>
                                    </td>
                                    <td class="p-4 text-gray-600"><%= admin.email %></td>
                                    <td class="p-4 text-gray-600"><span class="bg-blue-50 text-blue-600 px-2.5 py-1 rounded-md text-xs font-semibold"><%= admin.role %></span></td>
                                    <td class="p-4">
                                        <% if (admin.status === 'Active') { %>
                                            <span class="inline-flex items-center gap-1.5 bg-green-50 text-green-700 px-2.5 py-1 rounded-md text-xs font-semibold">
                                                <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Active
                                            </span>
                                        <% } else { %>
                                            <span class="inline-flex items-center gap-1.5 bg-gray-100 text-gray-600 px-2.5 py-1 rounded-md text-xs font-semibold">
                                                <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span> Inactive
                                            </span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="py-10 text-center flex flex-col items-center">
                    <div class="w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center text-gray-400 mb-4 text-2xl">
                        <i class="fa-solid fa-users-slash"></i>
                    </div>
                    <p class="text-gray-500 font-medium">No administrators assigned</p>
                    <p class="text-gray-400 text-sm mt-1">This hospital currently has no active administrators.</p>
                </div>
            <% } %>
        </div>
    </main>

    <%- include("../error_flash") %>
</body>
</html>
