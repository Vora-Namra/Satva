<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Satva — Create Hospital</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: "#10A37F",
              "primary-dark": "#0d8a6a",
              "primary-light": "#e6f7f3",
              "bg-page": "#f0faf6",
              dark: "#0f1923",
            },
            fontFamily: {
              sans: ["'DM Sans'", "system-ui", "sans-serif"],
              display: ["'Playfair Display'", "Georgia", "serif"],
            },
          },
        },
      };
    </script>
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <style>
      body {
        font-family: "DM Sans", sans-serif;
      }
    </style>
    <script type="module">
        import { checkSuperAdminJwt } from '/js/check-super-admin-jwt.js';
        checkSuperAdminJwt();
    </script>
  </head>
  <body class="bg-bg-page text-gray-800 min-h-screen flex flex-col">
    <!-- Navbar -->
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
      <div
        class="max-w-screen-2xl mx-auto px-6 py-4 flex items-center justify-between"
      >
        <a
          href="/super-admin/dashboard"
          class="flex items-center gap-2.5"
        >
          <div class="bg-primary rounded-lg p-1.5">
            <svg
              class="w-5 h-5 text-white"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
              />
            </svg>
          </div>
          <span class="text-xl font-bold text-gray-900 font-display"
            >Satva</span
          >
        </a>
        <div class="flex items-center gap-4">
          <a
            href="/super-admin/dashboard"
            class="text-sm font-semibold text-gray-600 hover:text-primary transition flex items-center gap-2"
          >
            <i class="fa-solid fa-arrow-left"></i>
            Back to Dashboard
          </a>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-1 max-w-3xl w-full mx-auto px-6 py-10">
      <div class="mb-8 flex items-center gap-4">
        <a
          href="/super-admin/dashboard"
          class="p-2 rounded-full hover:bg-gray-200 transition text-gray-600"
        >
          <i class="fa-solid fa-arrow-left"></i>
        </a>
        <div>
          <h2 class="text-2xl font-bold text-gray-800">Create New Hospital</h2>
          <p class="text-gray-500 text-sm mt-1">
            Register a new hospital on the platform.
          </p>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8">
        <form
          action="/api/v1/hospital/create-hospital"
          method="POST"
          class="space-y-6"
          novalidate
        >
          <!-- Hospital Name -->
          <div>
            <label
              for="hospital_name"
              class="block text-sm font-medium text-gray-700"
              >Hospital Name</label
            >
            <div class="mt-1 relative rounded-md shadow-sm">
              <div
                class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400"
              >
                <i class="fa-solid fa-hospital"></i>
              </div>
              <input
                type="text"
                name="hospital_name"
                id="hospital_name"
                required
                class="focus:ring-primary focus:border-primary block w-full pl-10 sm:text-sm border-gray-300 rounded-lg p-3 border outline-none transition"
                placeholder="e.g. City General Hospital"
              />
            </div>
            <p
              id="hospitalNameError"
              class="mt-1 text-sm text-red-500 hidden"
            ></p>
          </div>

          <!-- Contact Info (Email & Phone) -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700"
                >Official Email</label
              >
              <div class="mt-1 relative rounded-md shadow-sm">
                <div
                  class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400"
                >
                  <i class="fa-solid fa-envelope"></i>
                </div>
                <input
                  type="email"
                  name="email"
                  id="email"
                  required
                  class="focus:ring-primary focus:border-primary block w-full pl-10 sm:text-sm border-gray-300 rounded-lg p-3 border outline-none transition"
                  placeholder="contact@hospital.com"
                />
              </div>
              <p id="emailError" class="mt-1 text-sm text-red-500 hidden"></p>
            </div>
            <div>
              <label
                for="contact_number"
                class="block text-sm font-medium text-gray-700"
                >Contact Number</label
              >
              <div class="mt-1 relative rounded-md shadow-sm">
                <div
                  class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400"
                >
                  <i class="fa-solid fa-phone"></i>
                </div>
                <input
                  type="text"
                  name="contact_number"
                  id="contact_number"
                  required
                  class="focus:ring-primary focus:border-primary block w-full pl-10 sm:text-sm border-gray-300 rounded-lg p-3 border outline-none transition"
                  placeholder="e.g. +1 234 567 8900"
                />
              </div>
              <p id="phoneError" class="mt-1 text-sm text-red-500 hidden"></p>
            </div>
          </div>

          <!-- Address Line 1 -->
          <div>
            <label
              for="address_line1"
              class="block text-sm font-medium text-gray-700"
              >Address Line 1</label
            >
            <div class="mt-1 relative rounded-md shadow-sm">
              <div
                class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400"
              >
                <i class="fa-solid fa-map-location-dot"></i>
              </div>
              <input
                type="text"
                name="address_line1"
                id="address_line1"
                required
                class="focus:ring-primary focus:border-primary block w-full pl-10 sm:text-sm border-gray-300 rounded-lg p-3 border outline-none transition"
                placeholder="e.g. 123 Healthcare Ave"
              />
            </div>
            <p
              id="addressLine1Error"
              class="mt-1 text-sm text-red-500 hidden"
            ></p>
          </div>

          <!-- Address Line 2 -->
          <div>
            <label
              for="address_line2"
              class="block text-sm font-medium text-gray-700"
              >Address Line 2 (Optional)</label
            >
            <div class="mt-1 relative rounded-md shadow-sm">
              <div
                class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400"
              >
                <i class="fa-solid fa-building"></i>
              </div>
              <input
                type="text"
                name="address_line2"
                id="address_line2"
                class="focus:ring-primary focus:border-primary block w-full pl-10 sm:text-sm border-gray-300 rounded-lg p-3 border outline-none transition"
                placeholder="e.g. Suite 400"
              />
            </div>
          </div>

          <div
            class="pt-4 flex items-center justify-end gap-4 border-t border-gray-100 mt-6"
          >
            <a
              href="/super-admin/dashboard"
              class="text-sm font-medium text-gray-600 hover:text-gray-900 transition"
              >Cancel</a
            >
            <button
              type="submit"
              class="bg-primary hover:bg-primary-dark text-white font-medium py-2.5 px-6 rounded-lg shadow-sm transition flex items-center gap-2"
            >
              <i class="fa-solid fa-check"></i> Create Hospital
            </button>
          </div>
        </form>
      </div>
    </main>

    <%- include("../error_flash") %>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const form = document.querySelector("form");
        if (form) {
          form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalBtnText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML =
              '<i class="fa-solid fa-circle-notch fa-spin"></i> Processing...';

            let isValid = true;
            const hospitalName = document.getElementById("hospital_name");
            const email = document.getElementById("email");
            const contactNumber = document.getElementById("contact_number");
            const addressLine1 = document.getElementById("address_line1");
            const hospitalNameError =
              document.getElementById("hospitalNameError");
            const emailError = document.getElementById("emailError");
            const contactError = document.getElementById("phoneError");
            const addressLine1Error =
              document.getElementById("addressLine1Error");
            [hospitalName, email, contactNumber, addressLine1].forEach(
              (ele) => {
                ele.classList.remove("border-red-500");
              },
            );
            const errorEle = [
              hospitalNameError,
              emailError,
              contactError,
              addressLine1Error,
            ];
            errorEle.forEach((ele) => {
              ele.classList.add("hidden");
              ele.textContent = "";
            });
            if (hospitalName.value.trim() == "") {
              hospitalNameError.classList.remove("hidden");
              hospitalNameError.textContent = "Enter hospital name";
              hospitalName.classList.add("border-red-500");
              isValid = false;
            }
            if (email.value.trim() == "") {
              emailError.textContent = "Email is required";
              emailError.classList.remove("hidden");
              email.classList.add("border-red-500");
              isValid = false;
            } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) {
              emailError.textContent = "Enter valid email";
              emailError.classList.remove("hidden");
              email.classList.add("border-red-500");
              isValid = false;
            }
            if (contactNumber.value.trim() == "") {
              contactError.classList.remove("hidden");
              contactError.textContent = "Contact number is required";
              contactNumber.classList.add("border-red-500");
              isValid = false;
            } else if (!/^\+?[1-9]\d{6,14}$/.test(contactNumber.value.trim())) {
              contactError.classList.remove("hidden");
              contactError.textContent = "Enter valid phone number";
              contactNumber.classList.add("border-red-500");
              isValid = false;
            }
            if (addressLine1.value.trim() == "") {
              addressLine1Error.classList.remove("hidden");
              addressLine1Error.textContent =
                "First line of address is required";
              isValid = false;
            }
            if (!isValid) {
              e.preventDefault();
              submitBtn.disabled = false;
              submitBtn.innerHTML = originalBtnText;
            } else {
              try {
                const formData = new FormData(form);
                const data = Object.fromEntries(formData.entries());
                const url = form.action;

                const response = await fetch(url, {
                  method: "POST",
                  headers: { 
                    "Content-Type": "application/json",
                    "Authorization": `Bearer ${localStorage.getItem("accessToken")}`
                  },
                  body: JSON.stringify(data),
                });

                const result = await response.json();

                if (!response.ok || result.statusCode >= 400) {
                  throw new Error(result.message || "An error occurred");
                }

                if (typeof setFlash === "function") {
                  setFlash(
                    result.message || "Hospital created successfully",
                    "success",
                  );
                }

                setTimeout(() => {
                  window.location.href = "/super-admin/dashboard";
                }, 500);
              } catch (error) {
                if (typeof showFlash === "function") {
                  showFlash(
                    error.message || "Failed to process request",
                    "error",
                  );
                } else {
                  alert(error.message || "Failed to process request");
                }
              } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalBtnText;
              }
            }
          });
        }
      });
    </script>
  </body>
</html>
