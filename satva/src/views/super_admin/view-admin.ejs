<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Satva — View Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#10A37F",
                        "primary-dark": "#0d8a6a",
                        "primary-light": "#e6f7f3",
                        "bg-page": "#f0faf6",
                        dark: "#0f1923",
                    },
                    fontFamily: {
                        sans: ["'DM Sans'", "system-ui", "sans-serif"],
                        display: ["'Playfair Display'", "Georgia", "serif"],
                    },
                },
            },
        };
    </script>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        body { font-family: "DM Sans", sans-serif; }
    </style>
    <script type="module">
        import { checkSuperAdminJwt } from '/js/check-super-admin-jwt.js';
        checkSuperAdminJwt();
    </script>
</head>
<body class="bg-bg-page text-gray-800 min-h-screen flex flex-col">

    <!-- Navbar -->
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
        <div class="max-w-screen-2xl mx-auto px-6 py-4 flex items-center justify-between">
            <a href="/super-admin/dashboard" class="flex items-center gap-2.5">
                <div class="bg-primary rounded-lg p-1.5">
                    <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                </div>
                <span class="text-xl font-bold text-gray-900 font-display">Satva</span>
            </a>
            <div class="flex items-center gap-4">
                <a href="/super-admin/dashboard" class="text-sm font-semibold text-gray-600 hover:text-primary transition flex items-center gap-2">
                    <i class="fa-solid fa-arrow-left"></i>
                    Back to Dashboard
                </a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-1 max-w-3xl w-full mx-auto px-6 py-10">
        <div class="mb-8 flex justify-between items-center">
            <div class="flex items-center gap-4">
                <a href="/super-admin/dashboard" class="p-2 rounded-full hover:bg-gray-200 transition text-gray-600">
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
                <div>
                    <h2 class="text-2xl font-bold text-gray-800">Administrator Details</h2>
                    <p class="text-gray-500 text-sm mt-1">Viewing profile for <%= typeof admin !== 'undefined' ? admin.name : 'this admin' %></p>
                </div>
            </div>
            <a href="/super-admin/edit-admin/<%= typeof admin !== 'undefined' ? admin.id : '1' %>" class="bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium py-2 px-4 rounded-lg shadow-sm transition flex items-center gap-2">
                <i class="fa-solid fa-pen"></i> Edit Admin
            </a>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8">
            <div class="flex items-start gap-6 pb-6 border-b border-gray-100">
                <div class="w-20 h-20 rounded-full bg-primary-light text-primary flex items-center justify-center text-3xl font-bold font-display flex-shrink-0">
                    <%= typeof admin !== 'undefined' && admin.name ? admin.name.charAt(0).toUpperCase() : 'A' %>
                </div>
                <div>
                    <h3 class="text-2xl font-bold text-gray-900"><%= typeof admin !== 'undefined' ? admin.name : 'Admin User' %></h3>
                    <p class="text-gray-500 mt-1 flex items-center gap-2">
                        <i class="fa-solid fa-envelope w-4"></i> <%= typeof admin !== 'undefined' ? admin.email : 'admin@satva.health' %>
                    </p>
                    <div class="mt-3 flex gap-3">
                        <span class="px-3 py-1 text-xs font-semibold rounded-full bg-blue-50 text-blue-700 border border-blue-100">
                            <%= typeof admin !== 'undefined' ? admin.role : 'Admin' %>
                        </span>
                        <% const currentStatus = typeof admin !== 'undefined' ? admin.status : 'Active'; %>
                        <span class="px-3 py-1 text-xs font-semibold rounded-full <%= currentStatus === 'Active' ? 'bg-green-50 text-green-700 border border-green-100' : 'bg-red-50 text-red-700 border border-red-100' %>">
                            <%= currentStatus %>
                        </span>
                    </div>
                </div>
            </div>
            
            <div class="pt-6 grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-8">
                <div>
                    <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Account ID</h4>
                    <p class="text-gray-900 font-medium">#<%= typeof admin !== 'undefined' ? admin.id : '10245' %></p>
                </div>
                <div>
                    <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Joined Date</h4>
                    <p class="text-gray-900 font-medium"><%= typeof admin !== 'undefined' && admin.createdAt ? new Date(admin.createdAt).toLocaleDateString() : 'October 12, 2023' %></p>
                </div>
                <div>
                    <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Last Login</h4>
                    <p class="text-gray-900 font-medium">2 hours ago</p>
                </div>
                <div>
                    <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Permissions</h4>
                    <p class="text-gray-900 font-medium">Full Access</p>
                </div>
                <div>
                    <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Assigned Hospital</h4>
                    <p class="text-gray-900 font-medium"><%= typeof admin !== 'undefined' && admin.hospital_name ? admin.hospital_name : 'Global (Super Admin)' %></p>
                </div>
            </div>
            
        </div>
    </main>

    <%- include("../error_flash") %>
</body>
</html>
