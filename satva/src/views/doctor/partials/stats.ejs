

<section id="stats-section" class="w-full px-6 py-4">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

    <!-- Today's Appointments (highlighted) -->
    <div class="bg-teal-600 rounded-2xl p-6 flex flex-col justify-between min-h-[120px] shadow-md">
      <div class="flex items-center justify-between">
        <span class="text-white text-opacity-80 text-sm font-medium tracking-wide">Today's Appointments</span>
        <svg class="w-6 h-6 text-white opacity-70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
      </div>
      <p class="text-white text-5xl font-bold mt-3 leading-none" id="appointment_count"></p>
    </div>

    <!-- Total Patients -->
    <div class="bg-white rounded-2xl p-6 flex flex-col justify-between min-h-[120px] shadow-sm border border-gray-100">
      <div class="flex items-center justify-between">
        <span class="text-gray-500 text-sm font-medium tracking-wide">Upcoming</span>
        <svg class="w-6 h-6 text-teal-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-5-3.87M9 20H4v-2a4 4 0 015-3.87m6 5.87a4 4 0 10-8 0m8 0a4 4 0 00-8 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      </div>
      <p class="text-gray-800 text-5xl font-bold mt-3 leading-none" id="upcoming_count"></p>
    </div>

    <!-- Avg. Consultation -->
    <div class="bg-white rounded-2xl p-6 flex flex-col justify-between min-h-[120px] shadow-sm border border-gray-100">
      <div class="flex items-center justify-between">
        <span class="text-gray-500 text-sm font-medium tracking-wide">Rescheduled</span>
        <svg class="w-6 h-6 text-teal-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <p class="text-gray-800 text-5xl font-bold mt-3 leading-none" id="rescheduled_count"></p>
    </div>

    <!-- Records Updated -->
    <div class="bg-white rounded-2xl p-6 flex flex-col justify-between min-h-[120px] shadow-sm border border-gray-100">
      <div class="flex items-center justify-between">
        <span class="text-gray-500 text-sm font-medium tracking-wide">Cancelled</span>
        <svg class="w-6 h-6 text-teal-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
      </div>
      <p class="text-gray-800 text-5xl font-bold mt-3 leading-none" id="cancelled_count"></p>
    </div>

  </div>
</section>
