<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Patient Medical Records</title>
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          brand: {
            DEFAULT: '#14926f',
            dark: '#0f7a5b',
            light: '#eaf6f1',
          },
          danger: '#e0584a',
        }
      }
    }
  }
</script>
</head>
<body class="m-0 bg-[#f6f7f9] text-[#1c2125] font-sans">

<%-include('partials/header.ejs')%>

<div class="max-w-[880px] mx-auto px-6 pt-6 pb-12">

  <button id="backBtn" type="button" class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-gray-500 hover:text-gray-700 mb-4">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
    Back
  </button>

  <h2 id="patientName" class="text-[19px] font-bold m-0">Loading patient&hellip;</h2>
  <p id="patientMeta" class="text-[13px] text-gray-400 mt-1 mb-6">&nbsp;</p>

  <div class="bg-white border border-gray-200 rounded-2xl p-9 sm:p-9 max-sm:p-5">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-lg font-bold m-0">Medical Records</h1>
      <span id="recordCount" class="text-[12.5px] text-gray-400"></span>
    </div>

    <!-- Loading state -->
    <div id="loadingState" class="flex flex-col gap-3">
      <div class="h-[78px] rounded-xl bg-gray-100 animate-pulse"></div>
      <div class="h-[78px] rounded-xl bg-gray-100 animate-pulse"></div>
      <div class="h-[78px] rounded-xl bg-gray-100 animate-pulse"></div>
    </div>

    <!-- Empty state -->
    <div id="emptyState" class="hidden text-center text-gray-400 text-sm py-10 border border-dashed border-gray-200 rounded-xl">
      <svg class="mx-auto mb-2.5 text-gray-300" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
      </svg>
      No medical records found for this patient yet.
    </div>

    <!-- Error state -->
    <div id="errorState" class="hidden text-center text-danger text-sm py-10 border border-dashed border-red-200 rounded-xl bg-red-50">
      Couldn't load medical records. <button id="retryBtn" type="button" class="underline font-semibold">Retry</button>
    </div>

    <!-- Records list -->
    <div id="recordsList" class="flex flex-col gap-3"></div>
  </div>
</div>

<div id="toast" class="fixed top-5 right-5 bg-gray-900 text-white px-4.5 py-3 rounded-lg text-sm opacity-0 -translate-y-2 transition-all duration-200 pointer-events-none z-50"></div>

<script src="/js/patient_all_medical_records.js"></script>

</body>
</html>
