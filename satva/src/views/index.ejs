                <p class="text-[10px] text-gray-400">SMS sent</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== STATS ===== -->
    <section class="px-4 py-8 max-w-5xl mx-auto">
      <div
        class="bg-white rounded-2xl border border-gray-100 shadow-sm grid grid-cols-2 md:grid-cols-4 divide-x divide-gray-100"
