    <!-- ===== HOW IT WORKS ===== -->
    <section class="px-4 py-16 max-w-4xl mx-auto">
      <div class="text-center mb-14">
        <p
          class="text-primary text-sm font-semibold uppercase tracking-widest mb-2"
        >
          Process
        </p>
        <h2 class="font-display text-3xl font-bold text-gray-900">
          How It Works
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center relative">
        <div
          class="hidden md:block absolute top-7 left-1/4 right-1/4 h-0.5 bg-dashed border-t-2 border-dashed border-primary/30"
        ></div>
        <div class="flex flex-col items-center">
          <div
            class="w-14 h-14 rounded-full bg-primary text-white flex items-center justify-center text-xl font-bold mb-5 shadow-lg shadow-primary/25 z-10"
          >
            1
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Create Account</h3>
          <p class="text-sm text-gray-500 leading-relaxed max-w-xs mx-auto">
            Register quickly with your email and phone number for secure,
            personalised access.
          </p>
        </div>
        <div class="flex flex-col items-center">
          <div
            class="w-14 h-14 rounded-full bg-primary text-white flex items-center justify-center text-xl font-bold mb-5 shadow-lg shadow-primary/25 z-10"
