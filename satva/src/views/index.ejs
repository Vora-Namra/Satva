          </div>
          <h3 class="font-semibold text-gray-900 mb-2">24/7 Access</h3>
          <p class="text-sm text-gray-500 leading-relaxed">
            Manage appointments and view your health records anytime, anywhere.
          </p>
        </div>
      </div>
    </section>

    <!-- ===== SPECIALTIES ===== -->
    <section class="px-4 py-16 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <p
            class="text-primary text-sm font-semibold uppercase tracking-widest mb-2"
