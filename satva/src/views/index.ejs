        <div class="text-center py-7 px-4">
          <p class="text-3xl font-bold text-primary font-display">500+</p>
          <p class="text-sm text-gray-500 mt-1">Verified Doctors</p>
        </div>
        <div class="text-center py-7 px-4">
          <p class="text-3xl font-bold text-primary font-display">10K+</p>
          <p class="text-sm text-gray-500 mt-1">Happy Patients</p>
        </div>
        <div class="text-center py-7 px-4">
          <p class="text-3xl font-bold text-primary font-display">50K+</p>
          <p class="text-sm text-gray-500 mt-1">Appointments</p>
        </div>
        <div class="text-center py-7 px-4">
          <p class="text-3xl font-bold text-primary font-display">4.8★</p>
          <p class="text-sm text-gray-500 mt-1">Average Rating</p>
        </div>
      </div>
    </section>

    <!-- ===== WHY CHOOSE US ===== -->
    <section class="px-4 py-16 max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <p
