          <p class="text-sm text-gray-500 leading-relaxed max-w-xs mx-auto">
            Book your slot, pay securely online, and meet your doctor in-person
            or via video.
          </p>
        </div>
      </div>
    </section>

    <!-- ===== FEATURED DOCTORS ===== -->
    <section class="px-4 py-16 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="flex items-end justify-between mb-10">
          <div>
            <h2 class="font-display text-3xl font-bold text-gray-900">
