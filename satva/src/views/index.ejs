<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Satva — Hospital Appointment System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: "#10A37F",
              "primary-dark": "#0d8a6a",
              "primary-light": "#e6f7f3",
              "bg-page": "#f0faf6",
              dark: "#0f1923",
            },
            fontFamily: {
              sans: ["'DM Sans'", "system-ui", "sans-serif"],
              display: ["'Playfair Display'", "Georgia", "serif"],
            },
            keyframes: {
              fadeUp: {
                "0%": { opacity: 0, transform: "translateY(24px)" },
                "100%": { opacity: 1, transform: "translateY(0)" },
              },
              float: {
                "0%,100%": { transform: "translateY(0)" },
                "50%": { transform: "translateY(-8px)" },
              },
            },
            animation: {
              fadeUp: "fadeUp 0.7s ease both",
              "fadeUp-d1": "fadeUp 0.7s 0.1s ease both",
              "fadeUp-d2": "fadeUp 0.7s 0.2s ease both",
              "fadeUp-d3": "fadeUp 0.7s 0.3s ease both",
              "fadeUp-d4": "fadeUp 0.7s 0.4s ease both",
              float: "float 4s ease-in-out infinite",
            },
          },
        },
      };
    </script>
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "DM Sans", sans-serif;
      }
      .hero-blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.18;
        pointer-events: none;
      }
      .nav-link {
        position: relative;
      }
      .nav-link::after {
        content: "";
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 0;
        height: 2px;
        background: #10a37f;
        transition: width 0.3s;
      }
      .nav-link:hover::after {
        width: 100%;
      }
      .card-hover {
        transition:
          transform 0.25s,
          box-shadow 0.25s;
      }
      .card-hover:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(16, 163, 127, 0.12);
      }
      .stat-card {
        border-left: 3px solid #10a37f;
      }
      .testimonial-card {
        border-top: 3px solid #10a37f;
      }
    </style>
  </head>
  <body class="bg-[#f0faf6] text-gray-800 min-h-screen">
    <%- include('partials/header') %>

    <!-- ===== HERO ===== -->
    <section class="relative overflow-hidden pt-56 pb-36 px-4">
      <div class="hero-blob w-96 h-96 bg-primary top-0 -left-20"></div>
      <div class="hero-blob w-80 h-80 bg-emerald-300 top-20 right-0"></div>
      <div
        class="max-w-5xl mx-auto flex flex-col lg:flex-row items-center gap-12"
      >
        <div class="flex-1 text-center lg:text-left">
          <div
            class="inline-flex items-center gap-2 bg-primary-light text-primary text-xs font-semibold px-4 py-1.5 rounded-full mb-6 animate-fadeUp"
          >
            <span
              class="w-2 h-2 rounded-full bg-primary animate-pulse inline-block"
            ></span>
            Trusted by 10,000+ patients
          </div>
          <h1
            class="font-display text-5xl lg:text-6xl font-bold text-gray-900 leading-tight mb-5 animate-fadeUp-d1"
          >
            Your Health,<br />
            <span class="text-primary">Our Priority</span>
          </h1>
          <p
            class="text-gray-500 text-lg leading-relaxed max-w-md mx-auto lg:mx-0 mb-8 animate-fadeUp-d2"
          >
            Book appointments with top specialists, consult online, and manage
            your complete health journey — all in one place.
          </p>
          <div
            class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start animate-fadeUp-d3"
          >
            <a
              href="/api/v1/doctors"
              class="bg-white text-gray-700 font-semibold px-7 py-3.5 rounded-xl border border-gray-200 hover:border-primary hover:text-primary transition-all"
              >Browse Doctors</a
            >
          </div>
        </div>
        <!-- Hero card -->
        <div class="flex-1 flex justify-center animate-fadeUp-d4">
          <div class="relative">
            <div class="bg-white rounded-3xl shadow-2xl p-6 w-72 animate-float">
              <div class="flex items-center gap-3 mb-4">
                <div
                  class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center"
                >
                  <svg
                    class="w-6 h-6 text-primary"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                    />
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-gray-400">Upcoming</p>
                  <p class="text-sm font-semibold text-gray-900">Appointment</p>
                </div>
              </div>
              <div class="bg-primary-light rounded-2xl p-4 mb-3">
                <p class="text-xs text-primary font-semibold mb-1">
                  Dr. Priya Sharma
                </p>
                <p class="text-xs text-gray-500">Cardiologist</p>
                <div class="flex items-center gap-2 mt-2">
                  <svg
                    class="w-3.5 h-3.5 text-gray-400"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                  </svg>
                  <p class="text-xs text-gray-500">Tomorrow · 10:30 AM</p>
                </div>
              </div>
              <div class="flex gap-2">
                <button
                  class="flex-1 text-xs font-semibold bg-primary text-white py-2 rounded-lg hover:bg-primary-dark transition"
                >
                  Join Video Call
                </button>
                <button
                  class="flex-1 text-xs font-semibold bg-gray-50 text-gray-600 py-2 rounded-lg border hover:bg-gray-100 transition"
                >
                  Reschedule
                </button>
              </div>
            </div>
            <!-- Badge -->
            <div
              class="absolute -bottom-4 -left-6 bg-white shadow-lg rounded-2xl px-4 py-2.5 flex items-center gap-2"
            >
              <div
                class="w-7 h-7 rounded-full bg-emerald-100 flex items-center justify-center"
              >
                <svg
