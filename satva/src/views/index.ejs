          </h2>
          <p class="text-gray-500 mt-3 max-w-md mx-auto">
            Find the right specialist for your specific health concern.
          </p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
          <!-- Cardiology -->
          <a
            href="doctors.html"
            class="flex flex-col items-center gap-2 p-4 bg-[#f0faf6] rounded-2xl hover:bg-primary-light hover:shadow-md transition-all group"
