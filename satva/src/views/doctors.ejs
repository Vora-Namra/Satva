      // ─── Render grid ───────────────────────────────────────────────────────
      function renderPage() {
        const grid = document.getElementById("doctorGrid");
        const empty = document.getElementById("emptyState");
        const start = (currentPage - 1) * ITEMS_PER_PAGE;
        const slice = filteredDocs.slice(start, start + ITEMS_PER_PAGE);

        document.getElementById("countDisplay").textContent =
          filteredDocs.length;

        if (filteredDocs.length === 0) {
          grid.innerHTML = "";
          empty.classList.remove("hidden");
          empty.classList.add("flex");
          document.getElementById("pagination").innerHTML = "";
          return;
        }

        empty.classList.add("hidden");
        empty.classList.remove("flex");
        grid.innerHTML = slice.map((d, i) => doctorCard(d, i)).join("");
        renderPagination();
      }

      // ─── Pagination ────────────────────────────────────────────────────────
      function renderPagination() {
        const totalPages = Math.ceil(filteredDocs.length / ITEMS_PER_PAGE);
        if (totalPages <= 1) {
          document.getElementById("pagination").innerHTML = "";
          return;
        }

        let html = `
          <button class="page-btn w-9 h-9 rounded-xl border border-gray-200 bg-white flex items-center justify-center hover:border-primary hover:text-primary transition text-gray-600 shadow-sm"
            onclick="goPage(${currentPage - 1})" ${currentPage === 1 ? "disabled" : ""}>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          </button>`;

        for (let p = 1; p <= totalPages; p++) {
          if (
            totalPages > 7 &&
            p > 2 &&
            p < totalPages - 1 &&
            Math.abs(p - currentPage) > 1
          ) {
            if (p === 3 || p === totalPages - 2)
              html += `<span class="w-9 h-9 flex items-center justify-center text-gray-400 text-sm">…</span>`;
            continue;
          }
          html += `<button class="page-btn w-9 h-9 rounded-xl border text-sm font-semibold transition shadow-sm ${p === currentPage ? "active border-primary" : "border-gray-200 bg-white text-gray-600 hover:border-primary hover:text-primary"}"
            onclick="goPage(${p})">${p}</button>`;
        }

        html += `
          <button class="page-btn w-9 h-9 rounded-xl border border-gray-200 bg-white flex items-center justify-center hover:border-primary hover:text-primary transition text-gray-600 shadow-sm"
            onclick="goPage(${currentPage + 1})" ${currentPage === totalPages ? "disabled" : ""}>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </button>`;

        document.getElementById("pagination").innerHTML = html;
      }

      function goPage(p) {
        const total = Math.ceil(filteredDocs.length / ITEMS_PER_PAGE);
        if (p < 1 || p > total) return;
        currentPage = p;
        renderPage();
        window.scrollTo({ top: 0, behavior: "smooth" });
      }

      // ─── Filters ────────────
      function applyFilters() {
        const name = document
          .getElementById("searchName")
          .value.toLowerCase()
          .trim();
        const specialty = document.getElementById("filterSpecialty").value;
        const hospital = document.getElementById("filterHospital").value;
        const location = document.getElementById("filterLocation").value;
        const minRating =
          parseFloat(document.getElementById("filterRating").value) || 0;
        const maxFee =
          parseInt(document.getElementById("filterFee").value) || 9999;
        const available = document.getElementById("filterAvailable").checked;
        const sortBy = document.getElementById("sortBy").value;

        filteredDocs = DOCTORS.filter((d) => {
          const fullName = `${d.first_name} ${d.last_name}`.toLowerCase();
          if (name && !fullName.includes(name)) return false;
          if (specialty && !d.specialty.includes(specialty)) return false;
          if (hospital && d.hospital_name !== hospital) return false;
          if (location && d.location !== location) return false;
          if (selectedGender && d.gender !== selectedGender) return false;
          if (minRating > 0 && (d.rating || 0) < minRating) return false;
          if (d.consultation_fee > maxFee) return false;
          if (available && !d.available_today) return false;
          return true;
        });

        // Sort
        filteredDocs.sort((a, b) => {
          if (sortBy === "rating") return (b.rating || 0) - (a.rating || 0);
          if (sortBy === "fee_asc")
            return a.consultation_fee - b.consultation_fee;
          if (sortBy === "fee_desc")
            return b.consultation_fee - a.consultation_fee;
          if (sortBy === "experience")
            return b.experience_years - a.experience_years;
          if (sortBy === "name")
            return a.first_name.localeCompare(b.first_name);
          return 0;
        });

        currentPage = 1;
        renderPage();
        updateFilterBadge();
      }

      function setGender(g) {
        selectedGender = g;
        document
          .querySelectorAll("[id^='g']")
          .forEach((el) => el.classList.remove("active"));
        const map = { "": "gAll", MALE: "gMale", FEMALE: "gFemale" };
        document.getElementById(map[g])?.classList.add("active");
        applyFilters();
      }

      function quickSpecialty(s) {
        document.getElementById("filterSpecialty").value = s;
        document.querySelectorAll(".specialty-quick").forEach((el) => {
          el.classList.remove("bg-primary", "text-white", "border-primary");
          el.classList.add("bg-white", "text-gray-600", "border-gray-200");
        });
        event.currentTarget.classList.remove(
          "bg-white",
          "text-gray-600",
          "border-gray-200",
        );
        event.currentTarget.classList.add(
          "bg-primary",
          "text-white",
          "border-primary",
        );
        applyFilters();
      }

      function updateRatingDisplay() {
        const v = parseFloat(document.getElementById("filterRating").value);
        document.getElementById("ratingDisplay").textContent =
          v === 0 ? "Any" : v.toFixed(1) + "★";
