      // ─── Mobile filter drawer ──────────────────────────────────────────────
      function openFilterDrawer() {
        const drawer = document.getElementById("filterDrawer");
        drawer.classList.remove("hidden");
        // Force reflow so transition plays
        drawer.getBoundingClientRect();
        drawer.classList.add("open");
        const ov = document.getElementById("filterOverlay");
        ov.classList.remove("hidden");
        setTimeout(() => (ov.style.opacity = "1"), 10);
        document.body.style.overflow = "hidden";
      }
      function closeFilterDrawer() {
        const drawer = document.getElementById("filterDrawer");
        drawer.classList.remove("open");
        const ov = document.getElementById("filterOverlay");
        ov.style.opacity = "0";
        setTimeout(() => {
          ov.classList.add("hidden");
          // Only re-hide on mobile
          if (window.innerWidth < 768) drawer.classList.add("hidden");
        }, 350);
        document.body.style.overflow = "";
      }

      // Ensure sidebar visible on desktop after resize
      window.addEventListener("resize", () => {
        const drawer = document.getElementById("filterDrawer");
        if (window.innerWidth >= 768) {
          drawer.classList.remove("hidden", "open");
        } else if (!drawer.classList.contains("open")) {
          drawer.classList.add("hidden");
        }
      });

      // ─── Nav toggle ────────────────────────────────────────────────────────
      document.getElementById("menuBtn").addEventListener("click", () => {
        document.getElementById("mobileMenu").classList.toggle("hidden");
      });

      // ─── Init ──────────────────────────────────────────────────────────────
      applyFilters();
    </script>
  </body>
</html>
