      function updateFeeDisplay() {
        const v = parseInt(document.getElementById("filterFee").value);
        document.getElementById("feeDisplay").textContent =
          v >= 3000 ? "Any" : "₹" + v;
      }

      function resetFilters() {
        document.getElementById("searchName").value = "";
        document.getElementById("filterSpecialty").value = "";
        document.getElementById("filterHospital").value = "";
        document.getElementById("filterLocation").value = "";
        document.getElementById("filterRating").value = "0";
        document.getElementById("filterFee").value = "3000";
        document.getElementById("filterAvailable").checked = false;
        document.getElementById("sortBy").value = "rating";
        updateRatingDisplay();
        updateFeeDisplay();
        setGender("");
        document.querySelectorAll(".specialty-quick").forEach((el, i) => {
          el.classList.remove("bg-primary", "text-white", "border-primary");
          el.classList.add("bg-white", "text-gray-600", "border-gray-200");
          if (i === 0) {
            el.classList.add("bg-primary", "text-white", "border-primary");
            el.classList.remove("bg-white", "text-gray-600", "border-gray-200");
          }
        });
        applyFilters();
      }

      function updateFilterBadge() {
        const badge = document.getElementById("filterBadge");
        const name = document.getElementById("searchName").value.trim();
        const spec = document.getElementById("filterSpecialty").value;
        const hosp = document.getElementById("filterHospital").value;
        const loc = document.getElementById("filterLocation").value;
        const rating = parseFloat(
          document.getElementById("filterRating").value,
        );
        const fee = parseInt(document.getElementById("filterFee").value);
        const avail = document.getElementById("filterAvailable").checked;
        const active =
          name ||
          spec ||
          hosp ||
          loc ||
          selectedGender ||
          rating > 0 ||
          fee < 3000 ||
          avail;
        badge.classList.toggle("hidden", !active);
        badge.classList.toggle("flex", !!active);
      }

