          : `<span class="text-[10px] font-semibold text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">Next Available</span>`;

        return `
          <div class="bg-white rounded-2xl border border-gray-100 shadow-sm card-hover overflow-hidden animate-fadeUp cursor-pointer group"
