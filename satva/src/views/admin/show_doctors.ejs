<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard – Satva</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#10A37F',
            'primary-dark': '#0d8a6a',
            'primary-light': '#e6f7f3',
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
          },
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body class="bg-white min-h-screen font-sans text-gray-800">

  <div class="max-w-7xl mx-auto px-6 pt-7">
    <%- include('navbar.ejs') %>
  </div>

  <main class="max-w-7xl mx-auto px-6 py-8">
    <div class="mb-7">
      <h1 class="text-2xl font-bold text-gray-900">Admin Dashboard</h1>
      <p class="text-sm text-gray-400 mt-1">System overview and management</p>
    </div>

    <!-- stats -->
    <%- include('stats.ejs') %>

    <!-- Tabs -->
    <%- include('tabs.ejs') %>

    <!-- Search + Filters + Add -->
    <div class="flex items-center gap-3 mb-6">
      <div class="relative flex-1">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
          </svg>
        </span>
        <input
          id="searchInput"
          type="text"
          placeholder="Search doctors..."
          class="w-full pl-9 pr-4 py-2.5 border border-gray-200 rounded-lg text-sm text-gray-700 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
        />
      </div>

      <select
        id="specialtyFilter"
        onchange="currentPage=1; loadDoctors()"
        class="border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-700 outline-none focus:ring-2 focus:ring-primary bg-white"
      >
        <option value="">All Specialties</option>
      </select>

      <select
        id="statusFilter"
        onchange="currentPage=1; loadDoctors()"
        class="border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-700 outline-none focus:ring-2 focus:ring-primary bg-white"
      >
        <option value="">All Status</option>
        <option value="false">Active</option>
        <option value="true">Deactivated</option>
      </select>

      <button
        onclick="window.location.href = 'http://localhost:3333/admin/add-doctor'"
        class="flex items-center gap-2 bg-primary hover:bg-primary-dark text-white text-sm font-semibold px-4 py-2.5 rounded-lg transition"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM4 19.235v-.11a6.375 6.375 0 0112.75 0v.109A12.318 12.318 0 0110.374 21c-2.331 0-4.512-.645-6.374-1.766z" />
        </svg>
        Add Doctor
      </button>
    </div>

    <!-- Doctors List -->
    <div id="doctorsList" class="space-y-3">

      <!-- Skeleton -->
      <div id="loadingSkeleton" class="space-y-3">
        <div class="border border-gray-100 rounded-xl p-5 animate-pulse flex items-center gap-4">
          <div class="w-14 h-14 rounded-full bg-gray-200"></div>
          <div class="flex-1 space-y-2">
            <div class="h-4 bg-gray-200 rounded w-40"></div>
            <div class="h-3 bg-gray-100 rounded w-28"></div>
            <div class="h-3 bg-gray-100 rounded w-36"></div>
          </div>
        </div>
        <div class="border border-gray-100 rounded-xl p-5 animate-pulse flex items-center gap-4">
          <div class="w-14 h-14 rounded-full bg-gray-200"></div>
          <div class="flex-1 space-y-2">
            <div class="h-4 bg-gray-200 rounded w-40"></div>
            <div class="h-3 bg-gray-100 rounded w-28"></div>
            <div class="h-3 bg-gray-100 rounded w-36"></div>
          </div>
        </div>
        <div class="border border-gray-100 rounded-xl p-5 animate-pulse flex items-center gap-4">
          <div class="w-14 h-14 rounded-full bg-gray-200"></div>
          <div class="flex-1 space-y-2">
            <div class="h-4 bg-gray-200 rounded w-40"></div>
            <div class="h-3 bg-gray-100 rounded w-28"></div>
            <div class="h-3 bg-gray-100 rounded w-36"></div>
          </div>
        </div>
      </div>

      <!-- Error -->
      <div id="errorState" class="hidden flex-col items-center justify-center py-16 gap-3">
        <i class="ti ti-alert-circle text-3xl text-red-400"></i>
        <p class="text-sm font-medium text-gray-700">Failed to load doctors</p>
        <button onclick="loadDoctors()" class="text-sm text-primary hover:underline">Try again</button>
      </div>

      <!-- Container -->
      <div id="doctorsContainer" class="space-y-3 hidden"></div>

      <!-- Empty -->
      <div id="emptyState" class="hidden text-center py-12 text-gray-400">
        <svg class="w-10 h-10 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0" />
        </svg>
        <p class="text-sm">No doctors found</p>
      </div>

    </div>

    <!-- Pagination -->
    <div id="pagination" class="hidden items-center justify-between mt-5">
      <p id="pagination-info" class="text-sm text-gray-500"></p>
      <div class="flex items-center gap-2">
        <button id="prev-btn" onclick="changePage(-1)"
          class="px-3 py-1.5 text-sm border border-gray-200 rounded-lg hover:bg-gray-50 disabled:opacity-40 disabled:cursor-not-allowed transition">
          <i class="ti ti-chevron-left"></i> Prev
        </button>
        <button id="next-btn" onclick="changePage(1)"
          class="px-3 py-1.5 text-sm border border-gray-200 rounded-lg hover:bg-gray-50 disabled:opacity-40 disabled:cursor-not-allowed transition">
          Next <i class="ti ti-chevron-right"></i>
        </button>
      </div>
    </div>

  </main>

  <script>
    // ─── CONFIG ──────────────────────────────────────────────────────
    const API_BASE  = '/api/v1/admin';
    const PAGE_SIZE = 10;

    let allDoctors    = [];
    let currentPage    = 1;
    let totalRecords   = 0;
    let searchTimeout  = null;

    function getToken() {
      return localStorage.getItem('accessToken') ?? '';
    }

    // ── Helpers ───────────────────────────────────────
    function getInitials(first_name, last_name) {
      const f = first_name?.trim()[0] ?? '';
      const l = last_name?.trim()[0]  ?? '';
      return (f + l).toUpperCase();
    }

    function renderStars(rating) {
      if (!rating) return `<span class="text-xs text-gray-400">No rating</span>`;
      return `
        <svg class="w-3.5 h-3.5 text-yellow-400 inline" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
        <span class="text-xs text-gray-600">${parseFloat(rating).toFixed(1)}</span>`;
    }

    function formatFee(fee, currency_code) {
      if (!fee) return 'N/A';
      const symbol = currency_code ?? '₹';
      return `${symbol}${parseFloat(fee).toLocaleString()}`;
    }

    // ── Doctor card ────────────────────────────────────
    function doctorCard(doc) {
      const initials  = getInitials(doc.first_name, doc.last_name);
      const fullName  = `Dr. ${doc.first_name.trim()} ${doc.last_name.trim()}`;

      const status = doc.is_deactivated
        ? `<span class="text-xs font-medium text-red-500 bg-red-50 px-2 py-0.5 rounded-full">Inactive</span>`
        : `<span class="text-xs font-medium text-primary bg-primary-light px-2 py-0.5 rounded-full">Active</span>`;

      const actionText  = doc.is_deactivated ? 'Activate' : 'Deactivate';
      const actionClass = doc.is_deactivated
        ? 'border border-primary text-primary hover:bg-primary-light text-sm font-semibold px-4 py-2 rounded-lg transition'
        : 'bg-primary hover:bg-primary-dark text-white text-sm font-semibold px-4 py-2 rounded-lg transition';

      // ✅ profile_path → image, else initials
      const avatar = doc.profile_path
        ? `<img src="${doc.profile_path}" alt="${fullName}" class="w-14 h-14 rounded-full object-cover" />`
        : `<span class="text-white font-bold text-sm">${initials}</span>`;

      return `
        <div class="border border-gray-200 rounded-xl p-5 flex items-center gap-4 hover:shadow-sm transition" data-id="${doc.doctor_id}">

          <div class="w-14 h-14 rounded-full bg-primary flex items-center justify-center flex-shrink-0 overflow-hidden">
            ${avatar}
          </div>

          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <p class="font-bold text-gray-900">${fullName}</p>
              ${status}
            </div>
            <p class="text-sm text-gray-500 mt-0.5">
              ${doc.experience_years ? `${doc.experience_years} yrs exp` : 'Experience N/A'}
              &nbsp;•&nbsp;
              Fee: <span class="font-medium text-gray-700">${formatFee(doc.consultation_fee, doc.currency_code)}</span>
            </p>
            <div class="mt-1">${renderStars(doc.rating)}</div>
          </div>

          <div class="flex items-center gap-2 flex-shrink-0">
            <button onclick="viewDoctor(${doc.doctor_id})" class="border border-gray-200 text-gray-700 hover:bg-gray-50 text-sm font-medium px-4 py-2 rounded-lg transition">
              View Details
            </button>
            <button id="toggle-btn-${doc.doctor_id}" onclick="deactivate(${doc.doctor_id})" class="${actionClass}">
              ${actionText}
            </button>
          </div>

        </div>`;
    }

    function renderDoctors(list) {
      const container = document.getElementById('doctorsContainer');
      const empty     = document.getElementById('emptyState');

      if (!list || list.length === 0) {
        container.classList.add('hidden');
        empty.classList.remove('hidden');
        return;
      }

      empty.classList.add('hidden');
      container.innerHTML = list.map(doctorCard).join('');
      container.classList.remove('hidden');
    }

    // ── Pagination ─────────────────────────────────────
    function updatePagination() {
      const totalPages = Math.ceil(totalRecords / PAGE_SIZE) || 1;
      const start = (currentPage - 1) * PAGE_SIZE + 1;
      const end   = Math.min(currentPage * PAGE_SIZE, totalRecords);

      document.getElementById('pagination-info').textContent =
        totalRecords > 0
          ? `Showing ${start}–${end} of ${totalRecords} doctors`
          : 'No doctors to show';

      document.getElementById('prev-btn').disabled = currentPage === 1;
      document.getElementById('next-btn').disabled = currentPage >= totalPages;

      const pg = document.getElementById('pagination');
      pg.classList.remove('hidden');
      pg.classList.add('flex');
    }

    function changePage(delta) {
      currentPage += delta;
      loadDoctors();
    }

    // ── Load specialties for filter dropdown ────────────
    async function loadSpecialtyFilter() {
      try {
        const res = await fetch(`${API_BASE}/fetchSpecialties`, {
          headers: { 'Authorization': `Bearer ${getToken()}` }
        });
        if (!res.ok) return;

        const json        = await res.json();
        const specialties  = Array.isArray(json) ? json : (json.data ?? []);
        const select       = document.getElementById('specialtyFilter');

        specialties.forEach(s => {
          const opt       = document.createElement('option');
          opt.value       = s.specialty_id;
          opt.textContent = s.specialty_name;
          select.appendChild(opt);
        });
      } catch (err) {
        console.warn('Could not load specialty filter:', err);
      }
    }

    // ── Fetch doctors ────────────────────────────────────
    async function loadDoctors() {
      document.getElementById('loadingSkeleton').classList.remove('hidden');
      document.getElementById('doctorsContainer').classList.add('hidden');
      document.getElementById('emptyState').classList.add('hidden');
      document.getElementById('errorState').classList.add('hidden');
      document.getElementById('errorState').classList.remove('flex');
      document.getElementById('pagination').classList.add('hidden');

      const search       = document.getElementById('searchInput').value.trim();
      const specialtyId  = document.getElementById('specialtyFilter').value;
      const statusFilter = document.getElementById('statusFilter').value;

      try {
        const accessToken = getToken();

        const url = new URL(`${API_BASE}/showDoctors`, window.location.origin);
        url.searchParams.set('page',  currentPage);
        url.searchParams.set('limit', PAGE_SIZE);
        if (search)       url.searchParams.set('search', search);
        if (specialtyId)  url.searchParams.set('specialty_id', specialtyId);
        if (statusFilter) url.searchParams.set('is_deactivated', statusFilter);

        const res = await fetch(url.toString(), {
          headers: {
            Authorization: `Bearer ${accessToken}`,
            'Content-Type': 'application/json',
          },
        });

        if (!res.ok) throw new Error(`${res.status} ${res.statusText}`);

        const json     = await res.json();
        const payload   = json.data ?? json;
        allDoctors      = payload.data ?? [];
        totalRecords    = payload.total ?? allDoctors.length;

        renderDoctors(allDoctors);
        updatePagination();

      } catch (err) {
        allDoctors = [];
        renderDoctors([]);
        document.getElementById('doctorsContainer').classList.add('hidden');
        document.getElementById('emptyState').classList.add('hidden');
        const errEl = document.getElementById('errorState');
        errEl.classList.remove('hidden');
        errEl.classList.add('flex');
        console.error(err);
      } finally {
        document.getElementById('loadingSkeleton').classList.add('hidden');
      }
    }

    // ── Debounced search ─────────────────────────────────
    document.getElementById('searchInput').addEventListener('input', () => {
      clearTimeout(searchTimeout);
      currentPage = 1;
      searchTimeout = setTimeout(loadDoctors, 400);
    });

    // ── Actions ───────────────────────────────────────────
    function viewDoctor(id) {
      window.location.href = `/admin/doctor/${id}`;
    }

    // ── Deactivate / Activate toggle ────────────────────────
    async function deactivate(id) {
      const btn = document.getElementById(`toggle-btn-${id}`);
      if (!btn) return;

      const doctorRecord = allDoctors.find(doc => doc.doctor_id === id);
      if (!doctorRecord) return;

      const targetStatus = doctorRecord.is_deactivated ? 0 : 1;
      const accessToken  = getToken();

      btn.disabled = true;
      btn.style.opacity = '0.5';

      try {
        const response = await fetch(`${API_BASE}/toggleDoctorStatus/${id}`, {
          method: 'PUT',
          headers: {
            'Authorization': `Bearer ${accessToken}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ is_deactivated: targetStatus })
        });

        const resData = await response.json();

        if (response.ok) {
          doctorRecord.is_deactivated = targetStatus;
          renderDoctors(allDoctors);
        } else {
          showFlash(resData.message || 'Error occurred while updating physician access rights.', 'error');
          btn.disabled = false;
          btn.style.opacity = '1';
        }
      } catch (error) {
        console.error('Network Error:', error);
        showFlash('Cannot deactivate the doctor...Some problem has come.', 'error');
        btn.disabled = false;
        btn.style.opacity = '1';
      }
    }

    // ── Init ──────────────────────────────────────────────
    loadSpecialtyFilter();
    loadDoctors();
  </script>

  <script src="/js/stats.js"></script>
  <script src="/js/tabs.js"></script>

  <%- include('../error_flash.ejs') %>
</body>
</html>