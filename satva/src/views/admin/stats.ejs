<!-- views/partials/stats.ejs -->
<div class="grid grid-cols-4 gap-4 mb-7">

  <div class="border border-gray-200 rounded-xl p-5">
    <div class="flex items-center justify-between mb-2">
      <i class="ti ti-calendar text-green-600 text-2xl"></i>
      <span id="stat-appt-change" class="text-sm text-green-600 font-medium">—</span>
    </div>
    <div id="stat-appt" class="text-3xl font-medium text-gray-900 mb-1">—</div>
    <div class="text-sm text-gray-500">Today's Appointments</div>
  </div>

  <div class="border border-gray-200 rounded-xl p-5">
    <div class="flex items-center justify-between mb-2">
      <i class="ti ti-users text-green-600 text-2xl"></i>
      <span id="stat-patients-change" class="text-sm text-green-600 font-medium">—</span>
    </div>
    <div id="stat-patients" class="text-3xl font-medium text-gray-900 mb-1">—</div>
    <div class="text-sm text-gray-500">Active Patients</div>
  </div>

  <div class="border border-gray-200 rounded-xl p-5">
    <div class="flex items-center justify-between mb-2">
      <i class="ti ti-currency-dollar text-green-600 text-2xl"></i>
      <span id="stat-revenue-change" class="text-sm text-green-600 font-medium">—</span>
    </div>
    <div id="stat-revenue" class="text-3xl font-medium text-gray-900 mb-1">—</div>
    <div class="text-sm text-gray-500">Revenue (Today)</div>
  </div>

  <div class="border border-gray-200 rounded-xl p-5">
    <div class="flex items-center justify-between mb-2">
      <i class="ti ti-activity text-green-600 text-2xl"></i>
      <span id="stat-doctors-change" class="text-sm text-green-600 font-medium">—</span>
    </div>
    <div id="stat-doctors" class="text-3xl font-medium text-gray-900 mb-1">—</div>
    <div class="text-sm text-gray-500">Active Doctors</div>
  </div>

</div>