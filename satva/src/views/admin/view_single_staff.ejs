<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Staff Profile — Satva Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: { primary: '#00966B' }
        }
      }
    }
  </script>
</head>
<body class="bg-gray-50 font-sans min-h-screen">

  <div class="max-w-3xl mx-auto px-6 pt-7">
    <a href="/admin/staffs" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-green-600 transition mb-6">
      <i class="ti ti-arrow-left text-base"></i> Back to Staff Directory
    </a>
  </div>

  <div class="max-w-3xl mx-auto px-6 pb-12">

    <div id="loading-state" class="flex flex-col items-center justify-center py-20 gap-3 bg-white rounded-2xl border border-gray-200 shadow-sm">
      <i class="ti ti-loader-2 text-4xl text-green-600 animate-spin"></i>
      <p class="text-sm text-gray-500">Retrieving staff profile records...</p>
    </div>

    <div id="error-state" class="hidden flex flex-col items-center justify-center py-20 gap-3 bg-white rounded-2xl border border-gray-200 shadow-sm">
      <i class="ti ti-alert-circle text-4xl text-red-500"></i>
      <p class="text-sm font-semibold text-gray-800">Unable to load details</p>
      <p id="error-msg" class="text-xs text-gray-400"></p>
      <button onclick="fetchStaffDetails()" class="mt-2 px-4 py-2 bg-green-50 text-green-600 rounded-lg text-sm font-medium hover:bg-green-100 transition">Retry</button>
    </div>

    <div id="details-content" class="hidden bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
      
      <div class="border-b border-gray-100 p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-gradient-to-r from-white to-gray-50">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 bg-green-50 rounded-2xl border border-green-100 flex items-center justify-center text-green-600">
            <i class="ti ti-user-id text-2xl"></i>
          </div>
          <div>
            <h1 id="staff-fullname" class="text-xl font-bold text-gray-900">—</h1>
            <p class="text-sm text-gray-500 mt-0.5 flex items-center gap-2">
              <span id="staff-id" class="font-mono bg-gray-100 text-gray-600 px-1.5 py-0.5 rounded text-xs">Staff ID: —</span>
              <span id="user-id" class="font-mono bg-gray-100 text-gray-600 px-1.5 py-0.5 rounded text-xs">User ID: —</span>
            </p>
          </div>
        </div>
        <div>
          <span id="staff-role" class="text-xs font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-full border bg-emerald-50 text-emerald-700 border-emerald-200">
            —
          </span>
        </div>
      </div>

      <div class="p-6 sm:p-8 grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <div class="space-y-1">
          <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Contact Number</label>
          <div class="flex items-center gap-2.5 text-gray-800 font-medium">
            <i class="ti ti-phone text-gray-400 text-lg"></i>
            <span id="staff-phone">—</span>
          </div>
        </div>

        <div class="space-y-1">
          <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Gender</label>
          <div class="flex items-center gap-2.5 text-gray-800 font-medium">
            <i class="ti ti-gender-transgender text-gray-400 text-lg"></i>
            <span id="staff-gender">—</span>
          </div>
        </div>

        <div class="space-y-1">
          <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Date of Birth</label>
          <div class="flex items-center gap-2.5 text-gray-800 font-medium">
            <i class="ti ti-cake text-gray-400 text-lg"></i>
            <span id="staff-dob">—</span>
          </div>
        </div>

        <div class="space-y-1">
          <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Residential Address</label>
          <div class="flex items-center gap-2.5 text-gray-800 font-medium">
            <i class="ti ti-map-pin text-gray-400 text-lg"></i>
            <span id="staff-address">—</span>
          </div>
        </div>

      </div>

      <div class="border-t border-gray-100 bg-gray-50/50 px-6 py-4 flex flex-col sm:flex-row sm:justify-between gap-2 text-xs text-gray-400 font-medium">
        <div>Registered on: <span id="staff-created" class="text-gray-600">—</span></div>
        <div>Last Updated: <span id="staff-updated" class="text-gray-600">—</span></div>
      </div>

    </div>

  </div>

  <script>
    // ─── DYNAMIC PATH EXTENSION IDENTITY DISCOVERY ───────────────────
    // Extracts the terminal parameter '1' out of '/admin/getStaffById/1'
    const urlSegments = window.location.pathname.split('/');
    const STAFF_ID = urlSegments[urlSegments.length - 1];
    
    const TARGET_API_ENDPOINT = `http://localhost:3333/api/v1/admin/getStaffById/${STAFF_ID}`;

    // ─── VIEW TRANSITION STATE ENGINE ────────────────────────────────
    function displayState(showContent, showError = false) {
      document.getElementById('loading-state').style.display = 'none';
      document.getElementById('details-content').style.display = showContent ? 'block' : 'none';
      document.getElementById('error-state').style.display = showError ? 'flex' : 'none';
    }

    function formatDate(rawISOString) {
      if (!rawISOString) return '—';
      const dateInstance = new Date(rawISOString);
      return dateInstance.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
      });
    }

    // ─── DATA RETRIEVAL LOGIC ───────────────────────────────────────
    async function fetchStaffDetails() {
      // Safety validation wrapper check
      if (!STAFF_ID || isNaN(STAFF_ID)) {
        displayState(false, true);
        document.getElementById('error-msg').textContent = 'Invalid structural endpoint routing identity keys.';
        return;
      }

      try {
        const response = await fetch(TARGET_API_ENDPOINT, {
          method: 'GET',
          credentials: 'include', // Includes secure session cookies like refreshToken
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${localStorage.getItem('accessToken') ?? ''}`
          }
        });

        if (!response.ok) throw new Error(`Server returned structural fault code ${response.status}`);

        const resultJson = await response.json();
        
        // Safely extract the first element out of your object array payload structure
        const staff = Array.isArray(resultJson.data) ? resultJson.data[0] : resultJson.data;

        if (!staff) {
          throw new Error("Target staff profile dataset loaded empty.");
        }

        // Apply fields to target DOM components
        document.getElementById('staff-fullname').textContent = `${staff.first_name || ''} ${staff.last_name || ''}`.trim() || '—';
        document.getElementById('staff-id').textContent = `Staff ID: ${staff.staff_id}`;
        document.getElementById('user-id').textContent = `User ID: ${staff.user_id}`;
        document.getElementById('staff-role').textContent = (staff.staff_role || '—').replace('_', ' ');
        document.getElementById('staff-phone').textContent = staff.contact_number || '—';
        document.getElementById('staff-gender').textContent = (staff.gender || '—').toLowerCase();
        document.getElementById('staff-dob').textContent = formatDate(staff.dob);
        
        // Build address field strings
        const physicalLocStr = [staff.address_line1, staff.address_line2].filter(Boolean).join(', ');
        document.getElementById('staff-address').textContent = physicalLocStr || '—';

        // Stamp tracking fields
        document.getElementById('staff-created').textContent = formatDate(staff.created_at);
        document.getElementById('staff-updated').textContent = formatDate(staff.updated_at);

        // Render card
        displayState(true);

      } catch (err) {
        console.error("Profile parsing fault details:", err);
        displayState(false, true);
        document.getElementById('error-msg').textContent = err.message;
      }
    }

    // Run when page loads
    fetchStaffDetails();
  </script>
</body>
</html>