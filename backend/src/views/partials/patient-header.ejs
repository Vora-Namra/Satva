<script>
  document.addEventListener("DOMContentLoaded", () => {
  const profile = JSON.parse(localStorage.getItem("user") || "{}");
    console.log(profile)
  const patient = profile?.data;

  if (!patient) return;

  const fullName =
    `${patient.first_name || ""} ${patient.last_name || ""}`.trim();

  const userName = document.getElementById("userName");
  const userRole = document.getElementById("userRole");
  const userAvatar = document.getElementById("userAvatar");

  if (userName) userName.textContent = fullName || "Patient";
  if (userRole) userRole.textContent = "Patient";

  if (userAvatar) {
    userAvatar.src = patient.profile_path
      ? `/${patient.profile_path}`
      : `https://ui-avatars.com/api/?name=${encodeURIComponent(fullName || "Patient")}`;
  }
});
</script>
    <script type="module">
      import { logout } from "/js/logout.js";
      const logout_btn = document.getElementById("logoutBtn");
      logout_btn.addEventListener("click", async function (e) {
        e.preventDefault();
        await logout();
        
      });
    </script>

          <script src="/js/notification.js"></script>