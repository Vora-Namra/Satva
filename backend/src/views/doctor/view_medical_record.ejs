<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>View Medical Record</title>
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          brand: {
            DEFAULT: '#14926f',
            dark: '#0f7a5b',
            light: '#eaf6f1',
          },
          danger: '#e0584a',
        }
      }
    }
  }
</script>
</head>
<body class="m-0 bg-[#f6f7f9] text-[#1c2125] font-sans">

<%-include('partials/header.ejs')%>

<div class="max-w-[880px] mx-auto px-6 pt-6 pb-12">

  <button id="backBtn" type="button" class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-gray-500 hover:text-gray-700 mb-4">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
    Back to records
  </button>

  <h2 id="doctorName" class="text-[19px] font-bold m-0">&nbsp;</h2>
  <p id="visitMeta" class="text-[13px] text-gray-400 mt-1 mb-6">&nbsp;</p>

  <!-- Loading state -->
  <div id="loadingState" class="bg-white border border-gray-200 rounded-2xl p-9 flex flex-col gap-4">
    <div class="h-5 w-1/3 rounded bg-gray-100 animate-pulse"></div>
    <div class="h-20 rounded-xl bg-gray-100 animate-pulse"></div>
    <div class="h-20 rounded-xl bg-gray-100 animate-pulse"></div>
    <div class="h-20 rounded-xl bg-gray-100 animate-pulse"></div>
  </div>

  <!-- Error state -->
  <div id="errorState" class="hidden bg-white border border-gray-200 rounded-2xl p-9 text-center text-danger text-sm">
    Couldn't load this medical record. <button id="retryBtn" type="button" class="underline font-semibold">Retry</button>
  </div>

  <!-- Record content -->
  <div id="recordContent" class="hidden bg-white border border-gray-200 rounded-2xl p-9 sm:p-9 max-sm:p-5">
    <h1 class="text-lg font-bold mb-6">Medical Record</h1>

    <div class="mb-5">
      <label class="flex items-center gap-1.5 text-[13px] font-semibold text-gray-800 mb-2">
        <svg class="text-gray-400 flex-shrink-0" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        Patient Name
      </label>
      <input type="text" id="patientName" readonly
        class="w-full border border-gray-200 rounded-lg px-3.5 py-2.5 text-sm bg-gray-100 text-gray-600 cursor-not-allowed">
    </div>

    <div class="mb-5">
      <label class="flex items-center gap-1.5 text-[13px] font-semibold text-gray-800 mb-2">
        <svg class="text-gray-400 flex-shrink-0" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        Chief Complaint
      </label>
      <textarea id="chiefComplaint" readonly
        class="w-full border border-gray-200 rounded-lg px-3.5 py-2.5 text-sm bg-gray-100 text-gray-600 cursor-not-allowed resize-none min-h-[80px] leading-relaxed"></textarea>
    </div>

    <div class="mb-5">
      <label class="block text-[13px] font-semibold text-gray-800 mb-2">Examination Findings</label>
      <textarea id="examFindings" readonly
        class="w-full border border-gray-200 rounded-lg px-3.5 py-2.5 text-sm bg-gray-100 text-gray-600 cursor-not-allowed resize-none min-h-[80px] leading-relaxed"></textarea>
    </div>

    <div class="mb-5">
      <label class="block text-[13px] font-semibold text-gray-800 mb-2">Diagnosis (ICD-10)</label>
      <input type="text" id="diagnosis" readonly
        class="w-full border border-gray-200 rounded-lg px-3.5 py-2.5 text-sm bg-gray-100 text-gray-600 cursor-not-allowed">
    </div>

    <div class="mb-5">
      <label class="block text-[13px] font-semibold text-gray-800 mb-2">Prescription</label>
      <div id="rxEmpty" class="hidden text-center text-gray-400 text-sm py-5 border border-dashed border-gray-200 rounded-xl">No medicines were prescribed.</div>
      <div id="rxList" class="flex flex-col gap-2.5"></div>
    </div>

    <div class="mb-5">
      <label class="block text-[13px] font-semibold text-gray-800 mb-2">Additional Notes</label>
      <textarea id="notes" readonly
        class="w-full border border-gray-200 rounded-lg px-3.5 py-2.5 text-sm bg-gray-100 text-gray-600 cursor-not-allowed resize-none min-h-[80px] leading-relaxed"></textarea>
    </div>

    <div class="mb-2">
      <label class="block text-[13px] font-semibold text-gray-800 mb-2">Attached Files</label>
      <div id="filesEmpty" class="hidden text-center text-gray-400 text-sm py-5 border border-dashed border-gray-200 rounded-xl">No files were attached.</div>
      <div id="filesList" class="flex flex-col gap-2"></div>
    </div>
  </div>
</div>

<div id="toast" class="fixed top-5 right-5 bg-gray-900 text-white px-4.5 py-3 rounded-lg text-sm opacity-0 -translate-y-2 transition-all duration-200 pointer-events-none z-50"></div>

<script src="/js/view_medical_record.js"></script>

</body>
</html>
