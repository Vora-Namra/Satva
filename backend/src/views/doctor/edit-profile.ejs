<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>HealthCare – Edit Profile</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
    body { font-family: 'Inter', sans-serif; }

    
    .field-input:focus {
      outline: none;
      border-color: #0d9488;
      box-shadow: 0 0 0 3px rgba(13,148,136,0.12);
    }
   
    @keyframes slideUp {
      from { transform: translateY(20px); opacity: 0; }
      to   { transform: translateY(0);    opacity: 1; }
    }
    .toast-show { animation: slideUp 0.3s ease forwards; }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">

  <!-- ───────────── NAVBAR ───────────── -->
 <%-include('partials/header.ejs')%>
  <!-- ───────────── MAIN ───────────── -->
  <main class="max-w-4xl mx-auto px-6 py-8 space-y-6">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-500">
      <a href="/doctor/dashboard" class="hover:text-teal-600 transition">Dashboard</a>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      <a href="/doctor/profile" class="hover:text-teal-600 transition">Doctor Profile</a>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      <span class="text-gray-800 font-medium">Edit Profile</span>
    </nav>

    <!-- Page heading -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Edit Profile</h1>
        <p class="text-sm text-gray-500 mt-0.5">Update your professional information</p>
      </div>
      <!-- Unsaved changes badge (shown via JS) -->
      <span id="unsaved-badge" class="hidden items-center gap-1.5 text-xs font-medium text-amber-700 bg-amber-50 border border-amber-200 rounded-full px-3 py-1">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 inline-block"></span>
        Unsaved changes
      </span>
    </div>

    <!-- ══════════════════════════════════════
         SECTION 1 — PHOTO & IDENTITY
         ══════════════════════════════════════ -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
      <!-- Teal banner -->
      <div class="h-20"></div>

      <div class="px-6 pb-6 -mt-10">
        <div class="flex flex-col sm:flex-row sm:items-end gap-5 mb-5">
          <!-- Avatar upload -->
          <div class="relative flex-shrink-0">
            <div id="avatar-preview" class="w-20 h-20 rounded-2xl border-4 border-white shadow-md bg-teal-50 flex items-center justify-center overflow-hidden">
                <img src="/uploads/doctor_profile/default.png" alt="Profile" class="w-full h-full object-cover">
            </div>
            <!-- Upload overlay -->
            <label for="photo-upload" class="absolute inset-0 rounded-2xl bg-black bg-opacity-40 flex flex-col items-center justify-center cursor-pointer opacity-0 hover:opacity-100 transition-opacity">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/>
              </svg>
              <span class="text-white text-xs mt-0.5 font-medium">Upload</span>
            </label>
            <input id="photo-upload" type="file" accept="image/*" class="hidden" onchange="previewPhoto(event)"/>
          </div>

          <div class="pb-1">
            <p class="text-sm font-medium text-gray-700">Profile Photo</p>
            <p class="text-xs text-gray-400 mt-0.5">JPG, PNG or WEBP · max 2 MB · hover photo to change</p>
            <label for="photo-upload" class="inline-flex items-center gap-1.5 mt-2 text-xs font-medium text-teal-600 hover:text-teal-700 cursor-pointer transition">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/>
              </svg>
              Choose file
            </label>
          </div>
        </div>

        <!-- Read-only IDs -->
        <div class="grid grid-cols-2 gap-4 mb-5">
          <div>
            <label class="block text-xs font-medium text-gray-400 uppercase tracking-wider mb-1">Doctor ID</label>
            <div class="flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-xl px-3 py-2.5">
              <span class="text-sm font-mono text-gray-500">DOC-2024-0042</span>
              <svg class="w-4 h-4 text-gray-300 ml-auto flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
            </div>
            <p class="text-xs text-gray-400 mt-1">Auto-assigned · not editable</p>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-400 uppercase tracking-wider mb-1">Hospital ID</label>
            <div class="flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-xl px-3 py-2.5">
              <span class="text-sm font-mono text-gray-500">HSP-001</span>
              <svg class="w-4 h-4 text-gray-300 ml-auto flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
            </div>
            <p class="text-xs text-gray-400 mt-1">Assigned by admin · not editable</p>
          </div>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════════
         SECTION 2 — BASIC INFORMATION
         ══════════════════════════════════════ -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 space-y-5">
      <div class="flex items-center gap-2 border-b border-gray-100 pb-3">
        <div class="w-8 h-8 bg-teal-50 rounded-lg flex items-center justify-center">
          <svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        <h2 class="text-base font-semibold text-gray-900">Basic Information</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <!-- Full Name -->
        <div class="sm:col-span-2">
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Full Name <span class="text-red-400">*</span></label>
          <input type="text" value="Dr. Michael Chen" oninput="markDirty()" id="doctor_name"
            class="field-input w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-800 transition"/>
        </div>

        <!-- Experience Years -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Years of Experience <span class="text-red-400">*</span></label>
          <div class="relative">
            <input type="number" value="15" min="0" max="60" oninput="markDirty()" id="experience_years"
              class="field-input w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-800 transition pr-14"/>
            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-xs text-gray-400 font-medium">yrs</span>
          </div>
        </div>

        <!-- Consultation Fee -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Consultation Fee <span class="text-red-400">*</span></label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-sm text-gray-400 font-medium">₹</span>
            <input type="number" value="800" min="0" oninput="markDirty()" id="consultation_fee"
              class="field-input w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 pl-8 text-sm text-gray-800 transition"/>
          </div>
        </div>
      </div>

      <!-- Bio -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Bio</label>
        <textarea rows="4" oninput="markDirty(); autoResize(this)" id="bio"
          class="field-input w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-800 transition resize-none">Dr. Michael Chen is a board-certified interventional cardiologist with over 15 years of clinical experience managing complex cardiovascular conditions. He completed his fellowship at Johns Hopkins Hospital and has performed more than 2,000 cardiac catheterization procedures.</textarea>
        <p class="text-xs text-gray-400 mt-1">Brief professional summary shown on your public profile</p>
      </div>
    </div>

    <!-- ══════════════════════════════════════
         SECTION 3 — SPECIALTIES
         ══════════════════════════════════════ -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 space-y-4">
      <div class="flex items-center gap-2 border-b border-gray-100 pb-3">
        <div class="w-8 h-8 bg-teal-50 rounded-lg flex items-center justify-center">
          <svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
        </div>
        <h2 class="text-base font-semibold text-gray-900">Specialties</h2>
      </div>

      <!-- Tag list -->
      <div id="specialty-list" class="flex flex-wrap gap-2">
        <!-- Tags injected by JS -->
      </div>

      <!-- Add specialty input -->
     <div class="relative" id="specialty-dropdown-wrapper">
        <div class="flex gap-2">
          <div class="relative flex-1">
            <!-- Search input -->
            <div class="relative">
              <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 105 11a6 6 0 0012 0z"/>
              </svg>
              <input id="specialty-search" type="text" placeholder="Search specialties…" autocomplete="off"
                oninput="filterSpecialtyDropdown()"
                onfocus="openDropdown()"
                class="field-input w-full bg-gray-50 border border-gray-200 rounded-xl pl-10 pr-4 py-2.5 text-sm text-gray-800 transition"/>
              <!-- Loading spinner -->
              <svg id="specialty-spinner" class="hidden absolute right-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-teal-500 animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
              </svg>
            </div>

            <!-- Dropdown list -->
            <div id="specialty-dropdown"
              class="hidden absolute z-20 left-0 right-0 mt-1.5 bg-white border border-gray-200 rounded-xl shadow-lg overflow-hidden max-h-56 overflow-y-auto">
              <!-- Items injected by JS -->
            </div>
          </div>
        </div>
        <p class="text-xs text-gray-400 mt-2">Search and select from the list · click × on a tag to remove</p>
      </div>
    </div>

    <!-- ══════════════════════════════════════
         SECTION 4 — QUALIFICATIONS
         ══════════════════════════════════════ -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 space-y-4">
      <div class="flex items-center justify-between border-b border-gray-100 pb-3">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 bg-teal-50 rounded-lg flex items-center justify-center">
            <svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
            </svg>
          </div>
          <h2 class="text-base font-semibold text-gray-900">Qualifications</h2>
        </div>
        <button onclick="addQualification()"
          class="flex items-center gap-1.5 text-sm font-medium text-teal-600 hover:text-teal-700 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
          </svg>
          Add Qualification
        </button>
      </div>

      <div id="qualification-list" class="space-y-3">
        <!-- Qualification rows injected by JS -->
      </div>

      <p id="qual-empty" class="hidden text-sm text-gray-400 text-center py-4">No qualifications added yet. Click "Add Qualification" to begin.</p>
    </div>

    <!-- ══════════════════════════════════════
         STICKY ACTION BAR
         ══════════════════════════════════════ -->
    <div class="sticky bottom-0 bg-white border-t border-gray-100 shadow-lg -mx-6 px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-3 rounded-t-2xl z-20">
      <p class="text-xs text-gray-400 hidden sm:block">Changes are saved to your profile immediately after clicking Save.</p>
      <div class="flex gap-3 w-full sm:w-auto">
        <a href="/doctor/profile"
          class="flex-1 sm:flex-none text-center bg-white hover:bg-gray-50 text-gray-700 text-sm font-medium px-6 py-2.5 rounded-xl border border-gray-200 transition">
          Discard
        </a>
        <button onclick="saveProfile()"
          class="flex-1 sm:flex-none flex items-center justify-center gap-2 bg-teal-600 hover:bg-teal-700 text-white text-sm font-medium px-6 py-2.5 rounded-xl transition shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
          Save Changes
        </button>
      </div>
    </div>

  </main>

  <!-- Toast -->
  <div id="toast" class="fixed bottom-24 left-1/2 -translate-x-1/2 z-50 hidden">
    <div class="flex items-center gap-2 bg-gray-900 text-white text-sm font-medium px-5 py-3 rounded-xl shadow-lg">
      <svg class="w-4 h-4 text-teal-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
      </svg>
      Profile saved successfully
    </div>
  </div>

 <script src="/js/edit-profile.js"></script>
</body>
</html>
