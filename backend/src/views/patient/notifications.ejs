<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Satva — In-App Notifications & Alerts</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: "#10A37F",
              "primary-dark": "#0d8a6a",
              "primary-light": "#e6f7f3",
              "bg-page": "#f0faf6",
              dark: "#0f1923",
            },
            fontFamily: {
              sans: ["'DM Sans'", "system-ui", "sans-serif"],
              display: ["'Playfair Display'", "Georgia", "serif"],
            },
          },
        },
      };
    </script>

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />

    <style>
      body {
        font-family: "DM Sans", sans-serif;
      }
    </style>
  </head>

  <body class="bg-bg-page text-gray-800 min-h-screen flex flex-col">
    <%- include('../partials/patient-header', { title: 'notifications' }) %>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full">
      <!-- Breadcrumb & Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
          <a
            href="/patient/dashboard"
            class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-primary mb-2 transition"
          >
            <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
          </a>
          <h1 class="font-display text-3xl md:text-4xl font-bold text-dark flex items-center gap-3">
            <span>Notifications & Alerts</span>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-primary/10 text-primary uppercase tracking-wider">
              Live Feed
            </span>
          </h1>
          <p class="text-gray-500 text-sm mt-1">
            Real-time updates regarding your medical appointments, EHR reports, prescriptions, and billing.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <button
            id="markAllReadPageBtn"
            class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-primary bg-primary-light hover:bg-emerald-100 rounded-xl transition border border-primary/20"
          >
            <i class="fa-solid fa-check-double"></i> Mark all as read
          </button>
          <button
            class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-600 bg-white hover:bg-gray-50 rounded-xl transition border border-gray-200 shadow-sm"
          >
            <i class="fa-solid fa-sliders"></i> Notification Preferences
          </button>
        </div>
      </div>

      <!-- Filters & Stats Bar -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg">
            <i class="fa-solid fa-bell"></i>
          </div>
          <div>
            <p class="text-xs text-gray-500 font-medium">Total Alerts</p>
            <p class="text-xl font-bold text-dark">6 Notifications</p>
          </div>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg">
            <i class="fa-solid fa-calendar-check"></i>
          </div>
          <div>
            <p class="text-xs text-gray-500 font-medium">Appointments</p>
            <p class="text-xl font-bold text-dark">3 Updates</p>
          </div>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-lg">
            <i class="fa-solid fa-file-medical"></i>
          </div>
          <div>
            <p class="text-xs text-gray-500 font-medium">EHR & Lab Reports</p>
            <p class="text-xl font-bold text-dark">2 Available</p>
          </div>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-lg">
            <i class="fa-solid fa-receipt"></i>
          </div>
          <div>
            <p class="text-xs text-gray-500 font-medium">Billing Receipts</p>
            <p class="text-xl font-bold text-dark">1 Invoice</p>
          </div>
        </div>
      </div>

      <!-- Notifications List Card -->
      <div class="bg-white rounded-3xl border border-gray-200 shadow-sm overflow-hidden">
        <!-- Filter Tabs -->
        <div class="border-b border-gray-100 px-6 py-4 flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-2">
            <button class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-primary text-white transition">
              All (6)
            </button>
            <button class="px-3.5 py-1.5 rounded-full text-xs font-medium text-gray-600 hover:bg-gray-100 transition">
              Unread (2)
            </button>
            <button class="px-3.5 py-1.5 rounded-full text-xs font-medium text-gray-600 hover:bg-gray-100 transition">
              Appointments
            </button>
            <button class="px-3.5 py-1.5 rounded-full text-xs font-medium text-gray-600 hover:bg-gray-100 transition">
              Medical Records
            </button>
            <button class="px-3.5 py-1.5 rounded-full text-xs font-medium text-gray-600 hover:bg-gray-100 transition">
              Billing
            </button>
          </div>

          <div class="text-xs text-gray-400">
            Auto-refresh every 30 seconds
          </div>
        </div>

        <!-- List Entries -->
        <div class="divide-y divide-gray-100" id="notificationsFeed">
          <!-- Notification 1: Appointment Confirmation -->
          <div class="p-5 hover:bg-gray-50/70 transition flex items-start gap-4 bg-emerald-50/20">
            <div class="w-11 h-11 rounded-2xl bg-emerald-100 text-primary flex items-center justify-center text-lg flex-shrink-0">
              <i class="fa-solid fa-calendar-check"></i>
            </div>
            <div class="flex-1">
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2.5">
                  <span class="font-semibold text-gray-900 text-sm sm:text-base">Appointment Confirmed with Dr. John Doe</span>
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span class="text-xs font-medium bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-full">New</span>
                </div>
                <span class="text-xs text-gray-400 flex items-center gap-1">
                  <i class="fa-regular fa-clock"></i> 10 mins ago
                </span>
              </div>
              <p class="text-sm text-gray-600 mt-1 leading-relaxed">
                Your consultation booking for <strong class="text-gray-800">Cardiology General Checkup</strong> scheduled on <span class="font-medium text-primary">October 15, 2026 at 10:30 AM</span> at Satva Central Hospital has been confirmed by front-desk.
              </p>
              <div class="mt-3 flex items-center gap-3">
                <a href="/patient/my-appointments" class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:underline">
                  <i class="fa-solid fa-eye"></i> View Appointment Details
                </a>
                <span class="text-gray-300">•</span>
                <button class="text-xs text-gray-500 hover:text-gray-800">Dismiss</button>
              </div>
            </div>
          </div>

          <!-- Notification 2: Medical Record Uploaded -->
          <div class="p-5 hover:bg-gray-50/70 transition flex items-start gap-4 bg-emerald-50/20">
            <div class="w-11 h-11 rounded-2xl bg-purple-100 text-purple-700 flex items-center justify-center text-lg flex-shrink-0">
              <i class="fa-solid fa-file-waveform"></i>
            </div>
            <div class="flex-1">
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2.5">
                  <span class="font-semibold text-gray-900 text-sm sm:text-base">Lab Report & Prescription Attached</span>
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span class="text-xs font-medium bg-purple-50 text-purple-700 px-2 py-0.5 rounded-full">Medical EHR</span>
                </div>
                <span class="text-xs text-gray-400 flex items-center gap-1">
                  <i class="fa-regular fa-clock"></i> 2 hours ago
                </span>
              </div>
              <p class="text-sm text-gray-600 mt-1 leading-relaxed">
                Dr. John Doe added clinical progress notes, diagnosis summary, and digital prescription lines for your recent visit. Review your Google Gemini AI simplified summary.
              </p>
              <div class="mt-3 flex items-center gap-3">
                <a href="/patient/records" class="inline-flex items-center gap-1.5 text-xs font-semibold text-purple-700 hover:underline">
                  <i class="fa-solid fa-file-arrow-down"></i> Open Medical Record
                </a>
                <span class="text-gray-300">•</span>
                <button class="text-xs text-gray-500 hover:text-gray-800">Dismiss</button>
              </div>
            </div>
          </div>

          <!-- Notification 3: Payment Success -->
          <div class="p-5 hover:bg-gray-50/70 transition flex items-start gap-4">
            <div class="w-11 h-11 rounded-2xl bg-blue-100 text-blue-700 flex items-center justify-center text-lg flex-shrink-0">
              <i class="fa-solid fa-credit-card"></i>
            </div>
            <div class="flex-1">
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2.5">
                  <span class="font-semibold text-gray-900 text-sm sm:text-base">Payment Receipt Generated: ₹1,500</span>
                  <span class="text-xs font-medium bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full">Paid</span>
                </div>
                <span class="text-xs text-gray-400 flex items-center gap-1">
                  <i class="fa-regular fa-clock"></i> Yesterday, 4:15 PM
                </span>
              </div>
              <p class="text-sm text-gray-600 mt-1 leading-relaxed">
                Payment for Transaction <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded text-gray-700">#TXN-882319</code> via UPI (Google Pay) was successful. Tax invoice receipt #INV-004 is now available in your billing portal.
              </p>
              <div class="mt-3 flex items-center gap-3">
                <a href="/patient/payments" class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-700 hover:underline">
                  <i class="fa-solid fa-receipt"></i> View Payment Invoice
                </a>
                <span class="text-gray-300">•</span>
                <button class="text-xs text-gray-500 hover:text-gray-800">Dismiss</button>
              </div>
            </div>
          </div>

          <!-- Notification 4: Telemedicine Consultation Link -->
          <div class="p-5 hover:bg-gray-50/70 transition flex items-start gap-4">
            <div class="w-11 h-11 rounded-2xl bg-indigo-100 text-indigo-700 flex items-center justify-center text-lg flex-shrink-0">
              <i class="fa-solid fa-video"></i>
            </div>
            <div class="flex-1">
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2.5">
                  <span class="font-semibold text-gray-900 text-sm sm:text-base">Upcoming Video Consultation Link</span>
                  <span class="text-xs font-medium bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded-full">Telemedicine</span>
                </div>
                <span class="text-xs text-gray-400 flex items-center gap-1">
                  <i class="fa-regular fa-clock"></i> 2 days ago
                </span>
              </div>
              <p class="text-sm text-gray-600 mt-1 leading-relaxed">
                Your remote virtual check-in room has been provisioned. Please join 5 minutes early to test microphone and camera connectivity.
              </p>
              <div class="mt-3 flex items-center gap-3">
                <a href="#" class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-700 hover:underline">
                  <i class="fa-solid fa-headset"></i> Test Audio & Video
                </a>
              </div>
            </div>
          </div>

          <!-- Notification 5: Policy Pre-Authorization -->
          <div class="p-5 hover:bg-gray-50/70 transition flex items-start gap-4">
            <div class="w-11 h-11 rounded-2xl bg-teal-100 text-teal-700 flex items-center justify-center text-lg flex-shrink-0">
              <i class="fa-solid fa-shield-heart"></i>
            </div>
            <div class="flex-1">
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2.5">
                  <span class="font-semibold text-gray-900 text-sm sm:text-base">Health Insurance Document Verified</span>
                  <span class="text-xs font-medium bg-teal-50 text-teal-700 px-2 py-0.5 rounded-full">Insurance</span>
                </div>
                <span class="text-xs text-gray-400 flex items-center gap-1">
                  <i class="fa-regular fa-clock"></i> 4 days ago
                </span>
              </div>
              <p class="text-sm text-gray-600 mt-1 leading-relaxed">
                Your Star Health Insurance Policy #SH-882914-A uploaded via patient profile has been verified by the billing desk for cashless claims.
              </p>
              <div class="mt-3 flex items-center gap-3">
                <a href="/patient/profile" class="inline-flex items-center gap-1.5 text-xs font-semibold text-teal-700 hover:underline">
                  <i class="fa-solid fa-user-shield"></i> Review Policy in Profile
                </a>
              </div>
            </div>
          </div>

          <!-- Notification 6: System Maintenance -->
          <div class="p-5 hover:bg-gray-50/70 transition flex items-start gap-4">
            <div class="w-11 h-11 rounded-2xl bg-gray-100 text-gray-600 flex items-center justify-center text-lg flex-shrink-0">
              <i class="fa-solid fa-server"></i>
            </div>
            <div class="flex-1">
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2.5">
                  <span class="font-semibold text-gray-900 text-sm sm:text-base">Scheduled Cloud Maintenance Completed</span>
                  <span class="text-xs font-medium bg-gray-100 text-gray-700 px-2 py-0.5 rounded-full">System</span>
                </div>
                <span class="text-xs text-gray-400 flex items-center gap-1">
                  <i class="fa-regular fa-clock"></i> 1 week ago
                </span>
              </div>
              <p class="text-sm text-gray-600 mt-1 leading-relaxed">
                Hospital database indexing and automated backup tasks completed successfully with zero downtime.
              </p>
            </div>
          </div>
        </div>
      </div>
    </main>

    <footer class="bg-white border-t border-gray-200 mt-12 py-6 text-center text-xs text-gray-400">
      &copy; 2026 Satva Health Systems. All rights reserved. Secure Encrypted Medical Messaging.
    </footer>
  </body>
</html>
