<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Satva — Book Appointment</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: "#10A37F",
              "primary-dark": "#0d8a6a",
              "primary-light": "#e6f7f3",
              "bg-page": "#f0faf6",
              dark: "#0f1923",
            },
            fontFamily: {
              sans: ["'DM Sans'", "system-ui", "sans-serif"],
              display: ["'Playfair Display'", "Georgia", "serif"],
            },
            keyframes: {
              fadeUp: {
                "0%": { opacity: 0, transform: "translateY(24px)" },
                "100%": { opacity: 1, transform: "translateY(0)" },
              },
            },
            animation: {
              fadeUp: "fadeUp 0.6s ease both",
            },
          },
        },
      };
    </script>

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@700;800&display=swap"
      rel="stylesheet"
    />

    <style>
      body {
        font-family: "DM Sans", sans-serif;
      }
      .nav-link {
        position: relative;
      }
      .nav-link::after {
        content: "";
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 0;
        height: 2px;
        background: #10a37f;
        transition: width 0.3s;
      }
      .nav-link:hover::after {
        width: 100%;
      }
      .card-hover {
        transition:
          transform 0.25s,
          box-shadow 0.25s;
      }
      .card-hover:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(16, 163, 127, 0.12);
      }
      .step-active {
        background: #10a37f;
        color: white;
      }
      .step-completed {
        background: #10a37f;
        color: white;
      }
      .step-inactive {
        background: #f0faf6;
        color: #94a3b8;
      }
      input:focus,
      select:focus,
      textarea:focus {
        outline: none;
        border-color: #10a37f !important;
        box-shadow: 0 0 0 3px rgba(16, 163, 127, 0.12);
      }
      .slot-btn.selected,
      .date-btn.selected,
      .type-btn.selected {
        border-color: #10a37f !important;
        background: #e6f7f3 !important;
        color: #10a37f !important;
      }
    </style>
  </head>

  <body class="bg-bg-page text-gray-800 min-h-screen">
    <%- include('../partials/patient-header', { title: 'doctor-list' }) %>


    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="mb-8"></div>

      <div
        id="statusMsg"
        class="hidden mb-6 rounded-2xl border px-4 py-3 text-sm"
      ></div>
      <section id="searchSection" class="animate-fadeUp">
        <div class="mb-6">
          <h2
            class="font-display text-3xl sm:text-4xl font-bold text-dark mb-2"
          >
            Find a Doctor
          </h2>
          <p class="text-gray-500">
            Search by name, specialty, gender, hospital, and fee range.
          </p>
        </div>
        <a
          href="/patient/dashboard"
          id="backToSearchBtn"
          class="inline-flex items-center gap-2 text-gray-500 hover:text-dark mb-6"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 19l-7-7 7-7"
            ></path>
          </svg>
          Back to Dashboard
        </a>
        <div
          class="bg-white rounded-3xl border border-gray-200 shadow-sm p-5 sm:p-6 mb-6"
        >
          <div class="grid gap-4 lg:grid-cols-12">
            <div class="lg:col-span-4">
              <label class="block text-sm font-semibold text-gray-700 mb-2"
                >Doctor Name</label
              >
              <div class="relative">
                <svg
                  class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m21 21-4.35-4.35m1.35-5.65a7 7 0 11-14 0 7 7 0 0114 0z"
                  ></path>
                </svg>
                <input
                  id="searchName"
                  type="text"
                  placeholder="Search doctors by name..."
                  class="w-full pl-10 pr-4 py-3 rounded-2xl border border-gray-200 bg-white"
                />
              </div>
            </div>

            <div class="lg:col-span-3">
              <label class="block text-sm font-semibold text-gray-700 mb-2"
                >Specialty</label
              >
              <select
                id="searchSpecialty"
                class="w-full px-4 py-3 rounded-2xl border border-gray-200 bg-white"
              >
                <option value="">All Specialties</option>
                <option value="Cardiology">Cardiology</option>
                <option value="Dermatology">Dermatology</option>
                <option value="General Medicine">General Medicine</option>
                <option value="Pediatrics">Pediatrics</option>
                <option value="Orthopedics">Orthopedics</option>
                <option value="Gynecology">Gynecology</option>
                <option value="Neurology">Neurology</option>
              </select>
            </div>

            <div class="lg:col-span-2">
              <label class="block text-sm font-semibold text-gray-700 mb-2"
                >Gender</label
              >
              <select
                id="searchGender"
                class="w-full px-4 py-3 rounded-2xl border border-gray-200 bg-white"
              >
                <option value="">Any</option>
                <option value="MALE">Male</option>
                <option value="FEMALE">Female</option>
                <option value="OTHER">Other</option>
              </select>
            </div>

            <div class="lg:col-span-3">
              <label class="block text-sm font-semibold text-gray-700 mb-2"
                >Hospital ID</label
              >
              <input
                id="searchHospitalId"
                type="number"
                min="1"
                placeholder="Optional"
                class="w-full px-4 py-3 rounded-2xl border border-gray-200 bg-white"
              />
            </div>

            <div class="lg:col-span-6">
              <label class="block text-sm font-semibold text-gray-700 mb-2"
                >Minimum Fee</label
              >
              <input
                id="minFee"
                type="number"
                min="0"
                placeholder="Optional"
                class="w-full px-4 py-3 rounded-2xl border border-gray-200 bg-white"
              />
            </div>

            <div class="lg:col-span-6">
              <label class="block text-sm font-semibold text-gray-700 mb-2"
                >Maximum Fee</label
              >
              <input
                id="maxFee"
                type="number"
                min="0"
                placeholder="Optional"
                class="w-full px-4 py-3 rounded-2xl border border-gray-200 bg-white"
              />
            </div>
          </div>

          <div class="mt-5 flex flex-col sm:flex-row gap-3">
            <button
              id="searchBtn"
              type="button"
              class="bg-primary hover:bg-primary-dark text-white px-5 py-3 rounded-2xl font-semibold transition"
            >
              Search Doctors
            </button>
            <button
              id="clearBtn"
              type="button"
              class="bg-primary-light text-primary hover:bg-green-100 px-5 py-3 rounded-2xl font-semibold transition"
            >
              Clear Filters
            </button>
          </div>
        </div>

        <div id="doctorsContainer" class="space-y-5">
          <div
            class="bg-white rounded-3xl border border-gray-200 shadow-sm p-8 text-center text-gray-500"
          >
            Search for a doctor to begin.
          </div>
        </div>
      </section>

      <script type="module">
        import { checkJwt } from "/js/check-jwt.js";
        import { logout } from "/js/logout.js";

        checkJwt();
        const logout_btn = document.getElementById("logoutBtn");
        logout_btn.addEventListener("click", async function (e) {
          e.preventDefault();
          await logout();
        });

        const token = localStorage.getItem("accessToken");
        const username = localStorage.getItem("username");


        const searchBtn = document.getElementById("searchBtn");
        const clearBtn = document.getElementById("clearBtn");
        const doctorsContainer = document.getElementById("doctorsContainer");

        searchBtn.addEventListener("click", searchDoctors);

        clearBtn.addEventListener("click", () => {
          document.getElementById("searchName").value = "";
          document.getElementById("searchSpecialty").value = "";
          document.getElementById("searchGender").value = "";
          document.getElementById("searchHospitalId").value = "";
          document.getElementById("minFee").value = "";
          document.getElementById("maxFee").value = "";

          searchDoctors();
        });

        async function searchDoctors() {
          doctorsContainer.innerHTML = `
    <div class="bg-white rounded-3xl border border-gray-200 shadow-sm p-8 text-center">
      Loading doctors...
    </div>
  `;

          try {
            const params = new URLSearchParams();

            const name = document.getElementById("searchName").value.trim();

            const specialty = document.getElementById("searchSpecialty").value;

            const gender = document.getElementById("searchGender").value;

            const hospitalId =
              document.getElementById("searchHospitalId").value;

            const minFee = document.getElementById("minFee").value;

            const maxFee = document.getElementById("maxFee").value;

            if (name) params.append("name", name);

            if (specialty) params.append("specialty", specialty);

            if (gender) params.append("gender", gender);

            if (hospitalId) params.append("hospitalId", hospitalId);

            const response = await fetch(
              `/api/v1/patient/doctors?${params.toString()}`,
              {
                method: "GET",
                headers: {
                  Authorization: `Bearer ${token}`,
                },
              },
            );

            const result = await response.json();

            console.log(result);

            let doctors = result.data || [];

            if (minFee) {
              doctors = doctors.filter(
                (doctor) => Number(doctor.consultation_fee) >= Number(minFee),
              );
            }

            if (maxFee) {
              doctors = doctors.filter(
                (doctor) => Number(doctor.consultation_fee) <= Number(maxFee),
              );
            }

            if (!doctors.length) {
              doctorsContainer.innerHTML = `
        <div class="bg-white rounded-3xl border border-gray-200 shadow-sm p-8 text-center text-gray-500">
          No doctors found
        </div>
      `;

              return;
            }

            doctorsContainer.innerHTML = "";

            doctors.forEach((doctor) => {
              doctorsContainer.innerHTML += `
        <div class="bg-white rounded-3xl border border-gray-200 shadow-sm p-6 hover:shadow-lg transition">

          <div class="flex flex-col lg:flex-row justify-between gap-6">

            <div class="flex gap-4">

              <div class="w-16 h-16 rounded-full bg-primary text-white flex items-center justify-center font-bold text-lg">
                ${doctor.first_name.charAt(0)}
                ${doctor.last_name.charAt(0)}
              </div>

              <div>

                <h3 class="text-xl font-bold text-dark">
                  Dr. ${doctor.first_name}
                  ${doctor.last_name}
                </h3>

                <p class="text-gray-500">
                  ${doctor.specialties || doctor.specialty_name || "General"}
                </p>

                <p class="text-sm text-gray-500 mt-2">
                  Experience:
                  ${doctor.experience_years || 0}
                  Years
                </p>

                <p class="text-sm text-gray-500">
                  Hospital:
                  ${doctor.hospital_name || "N/A"}
                </p>

                <p class="text-sm font-semibold text-primary mt-2">
                  ₹${doctor.consultation_fee || 0}
                </p>

              </div>
            </div>

            <div class="flex items-center">

            <a
              class="bookBtn bg-primary hover:bg-primary-dark text-white px-5 py-3 rounded-xl font-semibold"
              href="/patient/doctors/${doctor.doctor_id}"
              data-id="${doctor.doctor_id}"
            >
              View Profile
            </a>

            </div>

          </div>

        </div>
      `;
            });

            document.querySelectorAll(".bookBtn").forEach((button) => {
              button.addEventListener("click", () => {
                const doctorId = button.dataset.id;

                localStorage.setItem("selectedDoctorId", doctorId);

                // next section
                document
                  .getElementById("searchSection")
                  .classList.add("hidden");

                document
                  .getElementById("appointmentSection")
                  .classList.remove("hidden");
              });
            });
          } catch (error) {
            console.error(error);

            doctorsContainer.innerHTML = `
      <div class="bg-white rounded-3xl border border-red-200 shadow-sm p-8 text-center text-red-600">
        Failed to load doctors
      </div>
    `;
          }
        }

        searchDoctors();
      </script>
    </main>
  </body>
</html>
