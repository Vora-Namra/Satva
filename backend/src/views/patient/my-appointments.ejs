<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Satva - My Appointments</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: "#10A37F",
              "primary-dark": "#0d8a6a",
              "primary-light": "#e6f7f3",
              "bg-page": "#f0faf6",
              dark: "#0f1923",
            },
            fontFamily: {
              sans: ["'DM Sans'", "system-ui", "sans-serif"],
              display: ["'Playfair Display'", "Georgia", "serif"],
            },
            keyframes: {
              fadeUp: {
                "0%": { opacity: 0, transform: "translateY(20px)" },
                "100%": { opacity: 1, transform: "translateY(0)" },
              },
            },
            animation: {
              fadeUp: "fadeUp 0.6s ease both",
            },
          },
        },
      };
    </script>

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@700;800&display=swap"
      rel="stylesheet"
    />

    <style>
      body {
        font-family: "DM Sans", sans-serif;
      }
      .nav-link {
        position: relative;
      }
      .nav-link::after {
        content: "";
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 0;
        height: 2px;
        background: #10a37f;
        transition: width 0.3s;
      }
      .nav-link:hover::after {
        width: 100%;
      }
      .card-hover {
        transition:
          transform 0.25s,
          box-shadow 0.25s;
      }
      .card-hover:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 32px rgba(16, 163, 127, 0.12);
      }
      .pill {
        border: 1px solid #dbe7e2;
      }
    </style>
  </head>

  <body class="bg-bg-page text-gray-800 min-h-screen flex flex-col">

    <%- include('../partials/patient-header', { title: 'my-appointments' }) %>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1">
      <div class="mb-8">
        <h2 class="font-display text-4xl font-bold text-dark mb-2">
          My Appointments
        </h2>
        <p class="text-gray-500">
          View all your booked appointments, status, and actions.
        </p>
      </div>

      <a
        href="/patient/dashboard"
        id="backToSearchBtn"
        class="inline-flex items-center gap-2 text-gray-500 hover:text-dark mb-6"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 19l-7-7 7-7"
          ></path>
        </svg>
        Back to dashboard
      </a>
      <div
        id="statusMsg"
        class="hidden mb-6 rounded-2xl border px-4 py-3 text-sm"
      ></div>

      <div
        class="bg-white rounded-3xl border border-gray-200 shadow-sm p-4 sm:p-5 mb-6"
      >
        <div
          class="flex flex-col lg:flex-row gap-4 lg:items-center lg:justify-between"
        >
          <div class="flex-1 relative">
            <svg
              class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m21 21-4.35-4.35m1.35-5.65a7 7 0 11-14 0 7 7 0 0114 0z"
              ></path>
            </svg>
            <input
              id="searchInput"
              type="text"
              placeholder="Search appointments..."
              class="w-full pl-11 pr-4 py-3 rounded-2xl border border-gray-200 bg-white"
            />
          </div>

          <div class="flex gap-3">
            <select
              id="statusFilter"
              class="px-4 py-3 rounded-2xl border border-gray-200 bg-white min-w-[180px]"
            >
              <option value="">All Status</option>
              <option value="CONFIRMED">Confirmed</option>
              <option value="PAYMENT_PENDING">Payment Pending</option>
              <option value="COMPLETED">Completed</option>
              <option value="CANCELLED">Cancelled</option>
              <option value="NO_SHOW">No Show</option>
              <option value="RESCHEDULED">Rescheduled</option>
            </select>

            <button
              id="filterBtn"
              type="button"
              class="px-5 py-3 rounded-2xl border border-gray-200 hover:bg-primary-light hover:text-primary transition font-semibold"
            >
              Filter
            </button>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-5">
        <div id="appointmentsContainer" class="space-y-5">
          <div
            class="bg-white rounded-3xl border border-gray-200 shadow-sm p-8 text-center text-gray-500"
          >
            Loading appointments...
          </div>
        </div>
      </div>
    </main>

    <div
      id="cancelModal"
      class="hidden fixed inset-0 z-50 bg-black/40 flex items-center justify-center px-4"
    >
      <div
        class="bg-white w-full max-w-lg rounded-3xl shadow-2xl border border-gray-100 p-6"
      >
        <h3 class="font-display text-2xl font-bold text-dark mb-2">
          Cancel Appointment
        </h3>
        <p class="text-gray-500 text-sm mb-5">
          Please share the reason for cancellation.
        </p>

        <textarea
          id="cancelReason"
          rows="4"
          class="w-full px-4 py-3 rounded-2xl border border-gray-200 bg-white"
          placeholder="Reason for cancellation..."
        ></textarea>

        <div class="mt-6 flex gap-3 justify-end">
          <button
            id="closeCancelModalBtn"
            type="button"
            class="px-5 py-3 rounded-2xl border border-gray-200 hover:bg-gray-50 font-semibold"
          >
            Close
          </button>
          <button
            id="confirmCancelBtn"
            type="button"
            class="px-5 py-3 rounded-2xl bg-red-600 hover:bg-red-700 text-white font-semibold"
          >
            Cancel Appointment
          </button>
        </div>
      </div>
    </div>

    <div
      id="rescheduleModal"
      class="hidden fixed inset-0 z-50 bg-black/40 flex items-center justify-center px-4"
    >
      <div
        class="bg-white w-full max-w-lg rounded-3xl shadow-2xl border border-gray-100 p-6"
      >
        <h3 class="font-display text-2xl font-bold text-dark mb-2">
          Reschedule Appointment
        </h3>
        <p class="text-gray-500 text-sm mb-5">Choose a new date and time.</p>

        <div class="space-y-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2"
              >Date</label
            >
            <input
              id="rescheduleDate"
              type="date"
              class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white"
            />
          </div>
          <div id="rescheduleSlotsContainer" class="grid grid-cols-3 gap-2">
             <div class="col-span-full text-xs text-gray-500 border border-dashed rounded-lg p-4 text-center">
              Please select a date to see available slots.
            </div>
          </div>
        </div>

        <div class="mt-6 flex gap-3 justify-end">
          <button
            id="closeRescheduleModalBtn"
            type="button"
            class="px-5 py-3 rounded-2xl border border-gray-200 hover:bg-gray-50 font-semibold"
          >
            Close
          </button>
          <button
            id="confirmRescheduleBtn"
            type="button"
            class="px-5 py-3 rounded-2xl bg-primary hover:bg-primary-dark text-white font-semibold"
          >
            Reschedule
          </button>
        </div>
      </div>
    </div>

    <%- include('../partials/footer') %>
    <script type="module" src="">
            const logout_btn = document.getElementById("logoutBtn");
          logout_btn.addEventListener("click", async function (e) {
            e.preventDefault();
            await logout();
          });
    </script>
    <script>
      const token = localStorage.getItem("accessToken");
      const username = localStorage.getItem("username");


      const state = {
        appointments: [],
        filtered: [],
        cancelAppointmentId: null,
        rescheduleAppointmentId: null,
        rescheduleDoctorId: null,
        rescheduleNewSlot: null,
      };

      const el = (id) => document.getElementById(id);

      function showMessage(message, type = "success") {
        const box = el("statusMsg");
        box.textContent = message;
        box.className = "mb-6 rounded-2xl border px-4 py-3 text-sm";

        if (type === "success") {
          box.classList.add(
            "border-green-200",     
            "bg-green-50",
            "text-green-700",
          );
        } else {
          box.classList.add("border-red-200", "bg-red-50", "text-red-700");
        }

        box.classList.remove("hidden");
      }

      function hideMessage() {
        el("statusMsg").classList.add("hidden");
      }

      function formatDate(value) {
        if (!value) return "--";
        const d = new Date(value);
        if (isNaN(d.getTime())) return value?.split("T")[0] || "--";

        return d.toLocaleDateString("en-IN", {
          day: "numeric",
          month: "long",
          year: "numeric",
        });
      }

      function formatTime(value) {
        if (!value) return "--";
        if (value.includes("AM") || value.includes("PM")) return value;

        const [hh, mm] = value.split(":");
        const h = Number(hh);
        const suffix = h >= 12 ? "PM" : "AM";
        const hour12 = ((h + 11) % 12) + 1;
        return `${hour12}:${mm} ${suffix}`;
      }

      function statusPill(status) {
        const map = {
          CONFIRMED: "bg-green-100 text-green-700",
          PAYMENT_PENDING: "bg-yellow-100 text-yellow-700",
          COMPLETED: "bg-blue-100 text-blue-700",
          CANCELLED: "bg-red-100 text-red-700",
          NO_SHOW: "bg-gray-100 text-gray-700",
          RESCHEDULED: "bg-primary-light text-primary",
        };

        return map[status] || "bg-gray-100 text-gray-700";
      }

      function renderAppointments(items) {
        const container = el("appointmentsContainer");

        if (!items.length) {
          container.innerHTML = `
          <div class="bg-white rounded-3xl border border-gray-200 shadow-sm p-8 text-center text-gray-500">
            No appointments found.
          </div>
        `;
          return;
        }

        container.innerHTML = items
          .map((appt) => {
            const doctorName =
              `Dr. ${appt.doctor_first_name || ""} ${appt.doctor_last_name || ""}`.trim();
            const specialties = appt.specialties || "General";
            const avatar =
              (appt.doctor_first_name || "D").charAt(0) +
              (appt.doctor_last_name || "D").charAt(0);

            const appointmentDateTime = new Date(
              `${appt.slot_date}T${appt.start_time}`
            );

            const isPastAppointment = appointmentDateTime < new Date();

            const canMutate =
              ["CONFIRMED", "PAYMENT_PENDING"].includes(appt.appointment_status) &&
              !isPastAppointment;

            return `
          <div class="bg-white rounded-3xl border border-gray-200 shadow-sm p-5 sm:p-6 card-hover">
            <div class="flex flex-col lg:flex-row lg:items-start gap-5">
              <div class="w-16 h-16 rounded-full bg-primary-light text-primary flex items-center justify-center text-xl font-bold shrink-0">
                ${avatar}
              </div>

              <div class="flex-1">
                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                  <div>
                    <h3 class="text-xl font-bold text-dark">${doctorName || "Doctor"}</h3>
                    <p class="text-gray-500">${specialties}${appt.hospital_name ? ` • ${appt.hospital_name}` : ""}</p>

                    <div class="flex flex-wrap items-center gap-4 mt-3 text-sm">
                      <div class="flex items-center gap-1 text-gray-600">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2Z"></path>
                        </svg>
                        <span>${formatDate(appt.slot_date)}</span>
                      </div>

                      <div class="flex items-center gap-1 text-gray-600">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2"></path>
                          <circle cx="12" cy="12" r="9"></circle>
                        </svg>
                        <span>${formatTime(appt.start_time)}</span>
                      </div>

                      <span class="px-2.5 py-1 rounded-full text-xs font-semibold ${
                        appt.appointment_type === "TELEMEDICINE"
                          ? "bg-blue-100 text-blue-700"
                          : "bg-primary-light text-primary"
                      }">
                        ${
                          appt.appointment_type === "TELEMEDICINE"
                            ? `
                            <a
                              href="${appt.meeting_link}"
                              target="_blank"
                              class="flex items-center gap-2"
                            >
                              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                stroke-width="1.5" stroke="currentColor" class="size-5">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                  d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z" />
                              </svg>
                              Join Meeting
                            </a>
                            `
                            : `
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                              stroke-width="1.5" stroke="currentColor" class="size-5">
                              <path stroke-linecap="round" stroke-linejoin="round"
                                d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                            </svg>
                            `
                        }
                      </span>

                      <span class="px-2.5 py-1 rounded-full text-xs font-semibold ${statusPill(appt.appointment_status)}">
                        ${appt.appointment_status}
                      </span>
                    </div>

                    <div class="mt-4 grid sm:grid-cols-2 gap-3 text-sm">
                      <div class="text-gray-600">
                        <span class="font-semibold text-dark">Confirmation:</span> ${appt.confirmation_no || "--"}
                      </div>
                      <div class="text-gray-600">
                        <span class="font-semibold text-dark">Fee:</span> ${appt.currency_code || "INR"} ${appt.consultation_fee || appt.payment_amount || 0}
                      </div>
                      <div class="text-gray-600 sm:col-span-2">
                        <span class="font-semibold text-dark">Chief Complaint:</span> ${appt.chief_complaint || "--"}
                      </div>
                    </div>
                  </div>

                  <div class="flex flex-row md:flex-col gap-3 md:items-end shrink-0">
                    <button
                      type="button"
                      class="rescheduleBtn px-4 py-2.5 rounded-2xl border border-gray-200 hover:bg-gray-50 font-semibold text-sm ${canMutate ? "" : "opacity-50 cursor-not-allowed"}"
                      data-id="${appt.appointment_id}"
                      data-doctor-id="${appt.doctor_id}"
                      ${canMutate ? "" : "disabled"}
                    >
                      Reschedule
                    </button>
                    <button
                      type="button"
                      class="cancelBtn px-4 py-2.5 rounded-2xl bg-red-600 hover:bg-red-700 text-white font-semibold text-sm ${canMutate ? "" : "opacity-50 cursor-not-allowed"}"
                      data-id="${appt.appointment_id}"
                      ${canMutate ? "" : "disabled"}
                    >
                      Cancel
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        `;
          })
          .join("");

        document.querySelectorAll(".cancelBtn").forEach((btn) => {
          btn.addEventListener("click", () => {
            state.cancelAppointmentId = btn.getAttribute("data-id");
            el("cancelReason").value = "";
            el("cancelModal").classList.remove("hidden");
          });
        });

        document.querySelectorAll(".rescheduleBtn").forEach((btn) => {
          btn.addEventListener("click", () => {
            state.rescheduleAppointmentId = btn.getAttribute("data-id");
            state.rescheduleDoctorId = btn.getAttribute("data-doctor-id");
            el("rescheduleDate").value = "";
            el("rescheduleModal").classList.remove("hidden");
          });
        });
      }

      async function loadAppointments() {
        hideMessage();

        if (!token) {
          showMessage("Login token not found. Please login again.", "error");
          return;
        }

        el("appointmentsContainer").innerHTML = `
        <div class="bg-white rounded-3xl border border-gray-200 shadow-sm p-8 text-center text-gray-500">
          Loading appointments...
        </div>
      `;

        try {
          const res = await fetch("/api/v1/appointments/patient", {
            method: "GET",
            headers: {
              Authorization: `Bearer ${token}`,
            },
          });

          const json = await res.json();
          console.log(json)
          if (!res.ok)
            throw new Error(json.message || "Failed to load appointments");

          state.appointments = json.data || [];
          state.filtered = [...state.appointments];
          renderAppointments(state.filtered);
        } catch (err) {
          el("appointmentsContainer").innerHTML = `
          <div class="bg-white rounded-3xl border border-gray-200 shadow-sm p-8 text-center text-red-600">
            ${err.message || "Failed to load appointments"}
          </div>
        `;
        }
      }

      function applyFilters() {
        const q = el("searchInput").value.trim().toLowerCase();
        const status = el("statusFilter").value.trim();

        state.filtered = state.appointments.filter((a) => {
          const doctor =
            `${a.doctor_first_name || ""} ${a.doctor_last_name || ""}`.toLowerCase();
          const complaint = (a.chief_complaint || "").toLowerCase();
          const confirmation = (a.confirmation_no || "").toLowerCase();
          const matchesText =
            !q ||
            doctor.includes(q) ||
            complaint.includes(q) ||
            confirmation.includes(q);
          const matchesStatus = !status || a.appointment_status === status;
          return matchesText && matchesStatus;
        });

        renderAppointments(state.filtered);
      }

      async function cancelAppointment() {
        if (!state.cancelAppointmentId) return;

        const reason = el("cancelReason").value.trim();
        if (!reason) {
          showMessage("Please enter a cancellation reason.", "error");
          return;
        }

        try {
          const res = await fetch(
            `/api/v1/appointments/${state.cancelAppointmentId}/cancel`,
            {
              method: "PATCH",
              headers: {
                Authorization: `Bearer ${token}`,
                "Content-Type": "application/json",
              },
              body: JSON.stringify({ reason }),
            },
          );

          const json = await res.json();
          if (!res.ok) throw new Error(json.message || "Cancellation failed");

          el("cancelModal").classList.add("hidden");
          showMessage("Appointment cancelled successfully.", "success");
          await loadAppointments();
        } catch (err) {
          showMessage(err.message || "Cancellation failed", "error");
        }
      }

      async function rescheduleAppointment() {
        if (!state.rescheduleAppointmentId) return;

        const slot_date = el("rescheduleDate").value;
        const start_time = state.rescheduleNewSlot;

        if (!slot_date || !start_time) {
          showMessage("Please select a new date and time slot.", "error");
          return;
        }

        try {
          const res = await fetch(
            `/api/v1/appointments/${state.rescheduleAppointmentId}/reschedule`,
            {
              method: "PATCH",
              headers: {
                Authorization: `Bearer ${token}`,
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                slot_date: slot_date,
                start_time: `${start_time}:00`,
              }),
            },
          );

          const json = await res.json();
          if (!res.ok) throw new Error(json.message || "Reschedule failed");

          el("rescheduleModal").classList.add("hidden");
          showMessage("Appointment rescheduled successfully.", "success");
          await loadAppointments();
        } catch (err) {
          showMessage(err.message || "Reschedule failed", "error");
        }
      }

      async function loadRescheduleSlots() {
        const date = el("rescheduleDate").value;
        const container = el("rescheduleSlotsContainer");
        state.rescheduleNewSlot = null;

        if (!date) {
          container.innerHTML = `<div class="col-span-full text-xs text-gray-500 border border-dashed rounded-lg p-4 text-center">Please select a date.</div>`;
          return;
        }

        container.innerHTML = `<div class="col-span-full text-xs text-gray-500 p-4 text-center">Loading slots...</div>`;

        try {
          const res = await fetch(`/api/v1/appointments/slots?doctorId=${state.rescheduleDoctorId}&date=${date}`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          const json = await res.json();
          if (!res.ok) throw new Error(json.message || 'Failed to load slots');

          const slots = json.data?.available_slots || [];
          if (!slots.length) {
            container.innerHTML = `<div class="col-span-full text-xs text-gray-500 border border-dashed rounded-lg p-4 text-center">${json.data?.reason || 'No slots available.'}</div>`;
            return;
          }

          container.innerHTML = slots.map(slot => `
            <button type="button" data-slot="${slot}" class="reschedule-slot-btn text-sm font-semibold border rounded-lg py-2 text-center transition hover:border-primary hover:bg-primary-light">
              ${formatTime(slot)}
            </button>
          `).join('');

          document.querySelectorAll('.reschedule-slot-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              document.querySelectorAll('.reschedule-slot-btn').forEach(b => b.classList.remove('bg-primary', 'text-white', 'border-primary'));
              btn.classList.add('bg-primary', 'text-white', 'border-primary');
              state.rescheduleNewSlot = btn.dataset.slot;
            });
          });

        } catch (err) {
          container.innerHTML = `<div class="col-span-full text-xs text-red-500 border border-dashed border-red-200 rounded-lg p-4 text-center">${err.message}</div>`;
        }
      }

      document.addEventListener("DOMContentLoaded", () => {
        loadAppointments();

        el("filterBtn").addEventListener("click", applyFilters);
        el("searchInput").addEventListener("input", applyFilters);
        el("statusFilter").addEventListener("change", applyFilters);

        el("rescheduleDate").addEventListener("change", loadRescheduleSlots);

        el("closeCancelModalBtn").addEventListener("click", () =>
          el("cancelModal").classList.add("hidden"),
        );
        el("closeRescheduleModalBtn").addEventListener("click", () =>
          el("rescheduleModal").classList.add("hidden"),
        );
        el("confirmCancelBtn").addEventListener("click", cancelAppointment);
        el("confirmRescheduleBtn").addEventListener(
          "click",
          rescheduleAppointment,
        );
      });
    </script>
  </body>
</html>
