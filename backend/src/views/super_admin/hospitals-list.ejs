<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Satva — Hospital Tenants Directory</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#10A37F",
                        "primary-dark": "#0d8a6a",
                        "primary-light": "#e6f7f3",
                        "bg-page": "#f0faf6",
                        dark: "#0f1923",
                    },
                    fontFamily: {
                        sans: ["'DM Sans'", "system-ui", "sans-serif"],
                        display: ["'Playfair Display'", "Georgia", "serif"],
                    },
                },
            },
        };
    </script>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        body { font-family: "DM Sans", sans-serif; }
    </style>
</head>
<body class="bg-bg-page text-gray-800 min-h-screen flex flex-col">

    <!-- Navbar -->
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
        <div class="max-w-screen-2xl mx-auto px-6 py-4 flex items-center justify-between">
            <a href="/super-admin/dashboard" class="flex items-center gap-2.5">
                <div class="bg-primary rounded-lg p-1.5">
                    <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                </div>
                <span class="text-xl font-bold text-gray-900 font-display">Satva</span>
                <span class="text-xs bg-primary-light text-primary font-bold px-2 py-0.5 rounded-full ml-1">Super Admin</span>
            </a>
            <div class="flex items-center gap-4">
                <a href="/super-admin/dashboard" class="text-sm font-semibold text-gray-600 hover:text-primary transition flex items-center gap-2">
                    <i class="fa-solid fa-chart-line"></i> Dashboard
                </a>
                <a href="/super-admin/create-admin" class="text-sm font-semibold text-gray-600 hover:text-primary transition flex items-center gap-2">
                    <i class="fa-solid fa-user-plus"></i> Add Admin
                </a>
                <a href="/hospital/create-hospital" class="bg-primary hover:bg-primary-dark text-white font-medium py-1.5 px-3.5 rounded-lg text-sm shadow-sm transition flex items-center gap-2">
                    <i class="fa-solid fa-plus"></i> New Tenant
                </a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-1 max-w-screen-2xl w-full mx-auto px-6 py-8">
        <!-- Title & Breadcrumb -->
        <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <a href="/super-admin/dashboard" class="text-xs text-gray-400 hover:text-primary flex items-center gap-1.5 mb-2 transition">
                    <i class="fa-solid fa-arrow-left"></i> Back to Platform Overview
                </a>
                <h1 class="text-3xl font-bold text-gray-900 font-display flex items-center gap-3">
                    <span>Hospital Tenants Directory</span>
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 uppercase tracking-wider">
                        Multi-Tenant Mesh
                    </span>
                </h1>
                <p class="text-gray-500 text-sm mt-1">
                    Central registry of active healthcare institutions, medical campuses, and branch hospital organizations.
                </p>
            </div>

            <div class="flex items-center gap-3">
                <a href="/hospital/create-hospital" class="bg-primary hover:bg-primary-dark text-white font-medium py-2 px-4 rounded-xl shadow-sm transition flex items-center gap-2 text-sm">
                    <i class="fa-solid fa-plus"></i> Onboard New Hospital
                </a>
            </div>
        </div>

        <!-- Tenant Overview Stats -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center text-xl flex-shrink-0">
                    <i class="fa-solid fa-hospital"></i>
                </div>
                <div>
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Active Tenants</p>
                    <p class="text-2xl font-bold text-gray-900"><%= typeof hospitals !== 'undefined' ? hospitals.length : 1 %> Hospitals</p>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl flex-shrink-0">
                    <i class="fa-solid fa-network-wired"></i>
                </div>
                <div>
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Deployment Tier</p>
                    <p class="text-2xl font-bold text-gray-900">Multi-Org Mesh</p>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl flex-shrink-0">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div>
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Data Isolation</p>
                    <p class="text-2xl font-bold text-gray-900">HIPAA Compliant</p>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl flex-shrink-0">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div>
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">System Health</p>
                    <p class="text-2xl font-bold text-emerald-600">100% Operational</p>
                </div>
            </div>
        </div>

        <!-- Directory Table Card -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="p-6 border-b border-gray-100 flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h3 class="text-lg font-bold text-gray-800">Hospital Organizations</h3>
                    <p class="text-xs text-gray-500 mt-0.5">Directory of all authorized hospital tenants with assigned administrators.</p>
                </div>
                <div class="flex items-center gap-3">
                    <div class="relative">
                        <i class="fa-solid fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                        <input
                            type="text"
                            placeholder="Filter by hospital or location..."
                            class="pl-9 pr-4 py-2 text-xs border border-gray-200 rounded-xl focus:ring-1 focus:ring-primary focus:outline-none w-64"
                        />
                    </div>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50/80">
                        <tr>
                            <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Hospital Entity</th>
                            <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Tenant ID</th>
                            <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Location & Address</th>
                            <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Contact Details</th>
                            <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                            <th scope="col" class="px-6 py-3.5 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-100 text-sm">
                        <% if (typeof hospitals !== 'undefined' && hospitals.length > 0) { %>
                            <% hospitals.forEach(hospital => { %>
                                <tr class="hover:bg-gray-50/60 transition">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex items-center gap-3.5">
                                            <div class="w-10 h-10 rounded-xl bg-primary-light text-primary flex items-center justify-center text-lg font-bold flex-shrink-0 border border-primary/20">
                                                <i class="fa-solid fa-hospital"></i>
                                            </div>
                                            <div>
                                                <p class="font-bold text-gray-900"><%= hospital.hospital_name %></p>
                                                <p class="text-xs text-gray-400">Multi-Specialty Facility</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="font-mono text-xs font-semibold px-2.5 py-1 rounded-md bg-gray-100 text-gray-700">
                                            #HOSP-<%= hospital.hospital_id %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <p class="text-gray-900 text-xs font-medium"><%= hospital.address_line1 %></p>
                                        <p class="text-gray-400 text-xs"><%= hospital.address_line2 || 'Main Campus' %></p>
                                    </td>
                                    <td class="px-6 py-4">
                                        <p class="text-xs text-gray-700 flex items-center gap-1.5">
                                            <i class="fa-solid fa-envelope text-gray-400"></i> <%= hospital.email %>
                                        </p>
                                        <p class="text-xs text-gray-700 flex items-center gap-1.5 mt-0.5">
                                            <i class="fa-solid fa-phone text-gray-400"></i> <%= hospital.contact_number %>
                                        </p>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Active Tenant
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right">
                                        <div class="inline-flex items-center gap-2">
                                            <a href="/hospital/view-hospital/<%= hospital.hospital_id %>" class="px-3 py-1.5 text-xs font-semibold text-primary bg-primary-light hover:bg-emerald-100 rounded-lg transition">
                                                <i class="fa-solid fa-eye mr-1"></i> View
                                            </a>
                                            <a href="/hospital/edit-hospital/<%= hospital.hospital_id %>" class="px-3 py-1.5 text-xs font-medium text-gray-600 bg-gray-50 hover:bg-gray-100 rounded-lg transition border border-gray-200">
                                                <i class="fa-solid fa-pen mr-1"></i> Edit
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="px-6 py-12 text-center text-gray-400">
                                    No hospital tenants found.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <footer class="bg-white border-t border-gray-200 mt-12 py-6 text-center text-xs text-gray-400">
        &copy; 2026 Satva Health Systems. Platform Super Administration Console.
    </footer>
</body>
</html>
