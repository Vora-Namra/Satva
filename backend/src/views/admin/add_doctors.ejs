
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Satva Admin - Add Doctor</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-800 min-h-screen font-sans antialiased">

    <header class="bg-white border-b border-gray-100 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-2">
                <div class="bg-[#00966B] p-2 rounded-xl text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                    </svg>
                </div>
                <span class="text-xl font-bold text-gray-900 tracking-tight">Satva</span>
            </div>
            
            <div class="flex items-center space-x-6">
                <button class="text-gray-500 hover:text-gray-700 transition relative">
                    <span class="absolute top-0 right-0 block h-2 w-2 rounded-full bg-red-500 ring-2 ring-white"></span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
                    </svg>
                </button>
                <button class="bg-[#EF4444] text-white px-4 py-2 rounded-lg font-medium hover:bg-red-600 transition flex items-center space-x-2 text-sm">
                    <span>Logout</span>
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        
        <div class="mb-6">
            <a href="/admin/doctors" class="inline-flex items-center text-sm font-medium text-[#00966B] hover:underline space-x-1">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                </svg>
                <span>Back to Dashboard</span>
            </a>
        </div>

        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Register New Doctor</h1>
            <p class="text-sm text-gray-500 mt-1">Populate details mapped directly to system requirements.</p>
        </div>

        <form id="add-doctor-form" method="POST" enctype="application/x-www-form-urlencoded" class="space-y-8">
            
            
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 md:p-8">
                <h2 class="text-lg font-bold text-gray-900 border-b border-gray-100 pb-3 mb-6 flex items-center gap-2 text-[#00966B]">
                    <span>01</span> Identity & Bio Information
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label for="first_name" class="block text-sm font-medium text-gray-700 mb-2">First Name *</label>
                        <input type="text" id="first_name" name="firstName" required placeholder="Michael"
                            class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00966B] focus:border-transparent transition text-sm">
                    </div>
                    <div>
                        <label for="last_name" class="block text-sm font-medium text-gray-700 mb-2">Last Name *</label>
                        <input type="text" id="last_name" name="lastName" required placeholder="Chen"
                            class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00966B] focus:border-transparent transition text-sm">
                    </div>
                    <div>
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-2">Email *</label>
                        <input type="text" id="email" name="email" required placeholder="doctor@gmail.com"
                            class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00966B] focus:border-transparent transition text-sm">
                    </div>
                    <div>
                        <label for="password" class="block text-sm font-medium text-gray-700 mb-2">Password *</label>
                        <input type="password" id="password" name="password" required placeholder=""
                            class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00966B] focus:border-transparent transition text-sm">
                    </div>
                    <div>
                        <label for="gender" class="block text-sm font-medium text-gray-700 mb-2">Gender Registration</label>
                        <select id="gender" name="gender" 
                            class="w-full px-4 py-2.5 border border-gray-200 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-[#00966B] focus:border-transparent transition text-sm text-gray-700">
                            <option value="" selected>Select Gender</option>
                            <option value="MALE">Male</option>
                            <option value="FEMALE">Female</option>
                            <option value="OTHER">Other</option>
                        </select>
                    </div>
                    
                    <div class="md:col-span-2">
                        <label for="bio" class="block text-sm font-medium text-gray-700 mb-2">Professional Biography Summary</label>
                        <textarea id="bio" name="bio" rows="4" placeholder="Describe the doctor's expert medical backgrounds, clinical research, or achievements..."
                            class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00966B] focus:border-transparent transition text-sm"></textarea>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 md:p-8">
                <h2 class="text-lg font-bold text-gray-900 border-b border-gray-100 pb-3 mb-6 flex items-center gap-2 text-[#00966B]">
                    <span>02</span> Practice & Commercial Operations
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    <div>
                        <label for="joined_at" class="block text-sm font-medium text-gray-700 mb-2">Contract Start Date</label>
                        <input type="date" id="joined_at" name="joined_at" 
                            class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00966B] focus:border-transparent transition text-sm">
                    </div>
                    <div>
                        <label for="experience_years" class="block text-sm font-medium text-gray-700 mb-2">Years of Practice</label>
                        <input type="number" id="experience_years" name="experienceYears" min="0" placeholder="Ex: 12"
                            class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00966B] focus:border-transparent transition text-sm">
                    </div>
                    <div>
                        <label for="consultation_fee" class="block text-sm font-medium text-gray-700 mb-2">Consultation Rate</label>
                        <input type="number" id="consultation_fee" name="consultationFee" min="0.00" step="0.01" placeholder="150.00"
                            class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00966B] focus:border-transparent transition text-sm">
                    </div>
                   
                  
                    
                </div>
            </div>

            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 md:p-8">
    <h2 class="text-lg font-bold text-gray-900 border-b border-gray-100 pb-3 mb-6 flex items-center gap-2 text-[#00966B]">
        <span>03</span> Expertise & Credentials
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
      <div class="bg-gray-50 rounded-xl p-5 border border-gray-100 h-fit">
  <h3 class="text-sm font-bold text-gray-800 mb-3 tracking-wide uppercase">
    Select Medical Specialties
  </h3>

  <!-- Loading state -->
  <div id="specialties-loading" class="flex items-center gap-2 py-4 text-sm text-gray-400">
    <svg class="animate-spin w-4 h-4 text-[#00966B]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
    </svg>
    Loading specialties...
  </div>

  <!-- Error state -->
  <div id="specialties-error" class="hidden text-sm text-red-500 py-3">
    Failed to load specialties.
    <button onclick="loadSpecialties()" class="underline text-[#00966B] ml-1">Retry</button>
  </div>

  <!-- Rendered checkboxes -->
  <div id="specialties-list" class="hidden space-y-2 max-h-64 overflow-y-auto pr-2">
    <!-- injected by JS -->
  </div>
</div>

        <div class="space-y-4">
            <div class="flex items-center justify-between border-b border-gray-100 pb-2">
                <h3 class="text-sm font-bold text-gray-800 tracking-wide uppercase">Academic Qualifications</h3>
                <button type="button" onclick="addQualificationRow()" class="inline-flex items-center space-x-1 text-xs font-semibold bg-emerald-50 text-[#00966B] hover:bg-emerald-100 px-2.5 py-1.5 rounded-lg transition">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    <span>Add Qualification</span>
                </button>
            </div>

            <div id="qualifications-container" class="space-y-6">
                
                <div class="qualification-row bg-white border border-gray-200 rounded-xl p-4 relative shadow-sm">
                    <div class="grid grid-cols-1 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Degree Name *</label>
                            <input type="text" name="qualification_degree[]" required placeholder="Ex: MD - Cardiology"
                                class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00966B] text-sm">
                        </div>
                        <div class="grid grid-cols-3 gap-3">
                            <div class="col-span-2">
                                <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Medical College *</label>
                                <input type="text" name="qualification_college[]" required placeholder="Ex: Harvard Medical School"
                                    class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00966B] text-sm">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Grad Year</label>
                                <input type="number" name="qualification_year[]" min="1950" max="2026" placeholder="2018"
                                    class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00966B] text-sm">
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

            
            

            <div class="flex items-center justify-end space-x-4 pt-4">
                <button type="button" class="px-5 py-2.5 border border-gray-200 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-100 transition duration-150">
                    Cancel Execution
                </button>
                <button type="submit" class="px-6 py-2.5 bg-[#00966B] hover:bg-[#007F5A] text-white rounded-lg text-sm font-semibold transition shadow-sm flex items-center space-x-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    <span>Commit Doctor Record</span>
                </button>
            </div>

        </form>
    </main>
  <script>
  function addQualificationRow() {
    const container = document.getElementById('qualifications-container');
    const rowHTML = `
      <div class="qualification-row bg-white border border-gray-200 rounded-xl p-4 relative shadow-sm">
        <button type="button" onclick="this.closest('.qualification-row').remove()"
          class="absolute -top-2 -right-2 bg-red-50 text-red-500 hover:bg-red-100 p-1 rounded-full border border-red-200 transition">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
        <div class="grid grid-cols-1 gap-3">
          <div>
            <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Degree Name *</label>
            <input type="text" name="qualification_degree[]" required placeholder="Ex: Fellowship in Interventional Cardiology"
              class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00966B] text-sm">
          </div>
          <div class="grid grid-cols-3 gap-3">
            <div class="col-span-2">
              <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Medical College *</label>
              <input type="text" name="qualification_college[]" required placeholder="Ex: Johns Hopkins University"
                class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00966B] text-sm">
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Grad Year</label>
              <input type="number" name="qualification_year[]" min="1950" max="2026" placeholder="2021"
                class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00966B] text-sm">
            </div>
          </div>
        </div>
      </div>
    `;
    container.insertAdjacentHTML('beforeend', rowHTML);
  }

  document.getElementById('add-doctor-form').addEventListener('submit', async function (e) {
    e.preventDefault(); // 

    const submitBtn = document.querySelector('[type="submit"]');
    submitBtn.disabled = true;
    submitBtn.innerHTML = 'Saving...';

    // ── Collect specialties (checked checkboxes) ──────────────────
    const specialties = [...document.querySelectorAll('input[name="specialties[]"]:checked')]
      .map(cb => Number(cb.value));

    // ── Collect qualifications (dynamic rows) ─────────────────────
    const degrees  = [...document.querySelectorAll('input[name="qualification_degree[]"]')].map(i => i.value.trim());
    const colleges = [...document.querySelectorAll('input[name="qualification_college[]"]')].map(i => i.value.trim());
    const years    = [...document.querySelectorAll('input[name="qualification_year[]"]')].map(i => Number(i.value));

    const qualifications = degrees.map((degree, idx) => ({
      degree,
      college_name:     colleges[idx] ?? '',
      graduation_year:  years[idx]    ?? null,
    })).filter(q => q.degree); // remove empty rows

    // ── Build final payload ───────────────────────────────────────
    const payload = {
      firstName:        document.getElementById('first_name').value.trim(),
      lastName:         document.getElementById('last_name').value.trim(),
      email:            document.getElementById('email').value.trim(),
      password:         document.getElementById('password').value,
      gender:           document.getElementById('gender').value || null,
      bio:              document.getElementById('bio').value.trim() || null,
      joined_at:        document.getElementById('joined_at').value || null,
      experienceYears:  Number(document.getElementById('experience_years').value) || null,
      consultationFee:  parseFloat(document.getElementById('consultation_fee').value) || null,
      specialties,
      qualifications,
    };

    console.log('Sending payload:', payload); // check in browser console

    try {
      const token = localStorage.getItem('accessToken');

      const res = await fetch('/api/v1/admin/addDoctor', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',       
          'Authorization': `Bearer ${token}`,       
        },
        body: JSON.stringify(payload),               
      });

      const json = await res.json();

      if (!res.ok) {
        throw new Error(json.message ?? `Error ${res.status}`);
      }

      setFlash('Doctor registered successfully!', 'success');
      window.location.href = '/admin/doctors';

    } catch (err) {
      showFlash(`Failed to register doctor: ${err.message}`, 'error');
      console.error(err);
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = 'Commit Doctor Record';
    }
  });

async function loadSpecialties() {
  const loading = document.getElementById('specialties-loading');
  const error   = document.getElementById('specialties-error');
  const list    = document.getElementById('specialties-list');

  // reset states
  loading.classList.remove('hidden');
  error.classList.add('hidden');
  list.classList.add('hidden');
  list.innerHTML = '';

  try {
    const token = localStorage.getItem('accessToken');

    const res = await fetch('/api/v1/admin/fetchSpecialties', {
      headers: {
        'Content-Type':  'application/json',
        'Authorization': `Bearer ${token}`,
      }
    });

    if (!res.ok) throw new Error(`${res.status}`);

    const json         = await res.json();
    const specialties  = Array.isArray(json) ? json : (json.data ?? []);

    if (specialties.length === 0) {
      error.textContent = 'No specialties found.';
      error.classList.remove('hidden');
      return;
    }

    // Render a checkbox per specialty
    list.innerHTML = specialties.map(s => `
      <label class="flex items-center space-x-3 bg-white p-2.5 rounded-lg border border-gray-200 hover:border-[#00966B] transition cursor-pointer">
        <input
          type="checkbox"
          name="specialties[]"
          value="${s.specialty_id}"
          class="w-4 h-4 rounded text-[#00966B] focus:ring-[#00966B] border-gray-300"
        >
        <span class="text-sm text-gray-700">${s.specialty_name}</span>
      </label>
    `).join('');

    list.classList.remove('hidden');

  } catch (err) {
    error.classList.remove('hidden');
    console.error('Failed to load specialties:', err);
  } finally {
    loading.classList.add('hidden');
  }
}

// ── Call on page load ─────────────────────────────────────────
loadSpecialties();

</script>

<%- include('../error_flash.ejs') %>
</body>
</html>
