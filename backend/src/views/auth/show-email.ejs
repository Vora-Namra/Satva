<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Satva — OTP Sent</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: "#10A37F",
            "primary-dark": "#0d8a6a",
            "primary-light": "#e6f7f3",
            "bg-page": "#f0faf6",
            dark: "#0f1923",
          },
          fontFamily: {
            sans: ["'DM Sans'", "system-ui", "sans-serif"],
            display: ["'Playfair Display'", "Georgia", "serif"],
          },
          keyframes: {
            fadeUp: {
              "0%": { opacity: 0, transform: "translateY(20px)" },
              "100%": { opacity: 1, transform: "translateY(0)" },
            },
          },
          animation: {
            fadeUp: "fadeUp 0.6s ease both",
            "fadeUp-d1": "fadeUp 0.6s 0.1s ease both",
          },
        },
      },
    };
  </script>
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@700;800&display=swap"
    rel="stylesheet" />
  <style>
    body {
      font-family: "DM Sans", sans-serif;
    }

    .hero-blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.18;
      pointer-events: none;
    }

    .panel-dots {
      background-image: radial-gradient(circle,
          rgba(255, 255, 255, 0.25) 1px,
          transparent 1px);
      background-size: 22px 22px;
    }

    .nav-link::after {
      content: "";
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 0;
      height: 2px;
      background: #10a37f;
      transition: width 0.3s;
    }

    .nav-link:hover::after {
      width: 100%;
    }

    .otp-code {
      letter-spacing: 0.3em;
      font-variant-numeric: tabular-nums;
    }
  </style>
</head>

<body class="bg-[#f0faf6] text-gray-800 min-h-screen flex flex-col">
  <!-- ===== NAVBAR ===== -->
  <nav class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-100 shadow-sm">
    <div class="max-w-screen-xl flex items-center justify-between mx-auto px-6 py-4">
      <a href="/" class="flex items-center gap-2.5">
        <div class="bg-primary rounded-xl p-2">
          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
        </div>
        <span class="text-xl font-bold text-gray-900 font-display">Satva</span>
      </a>

      <div class="hidden md:flex items-center gap-8">
        <a href="/"
          class="nav-link relative text-sm font-medium text-gray-600 hover:text-primary transition-colors">Home</a>
        <a href="/doctors"
          class="nav-link relative text-sm font-medium text-gray-600 hover:text-primary transition-colors">Doctors</a>
        <a href="/about"
          class="nav-link relative text-sm font-medium text-gray-600 hover:text-primary transition-colors">About</a>
        <a href="/contact"
          class="nav-link relative text-sm font-medium text-gray-600 hover:text-primary transition-colors">Contact</a>
      </div>

      <div class="hidden md:flex items-center gap-3">
        <a href="login-page" class="text-sm font-medium text-gray-700 hover:text-primary px-4 py-2">Login</a>
        <a href="register-page"
          class="text-sm font-semibold bg-primary text-white px-5 py-2.5 rounded-xl hover:bg-primary-dark transition">Register</a>
      </div>

      <button id="menuBtn" class="md:hidden text-gray-700 focus:outline-none">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <div id="mobileMenu" class="hidden md:hidden bg-white border-t border-gray-100">
      <div class="flex flex-col p-4 space-y-4">
        <a href="/" class="text-gray-600 font-medium hover:text-primary transition">Home</a>
        <a href="/doctors" class="text-gray-600 hover:text-primary transition">Doctors</a>
        <a href="/about" class="text-gray-600 hover:text-primary transition">About</a>
        <a href="/contact" class="text-gray-600 hover:text-primary transition">Contact</a>
        <hr />
        <a href="/login" class="text-primary font-semibold">Login</a>
        <a href="/register"
          class="bg-primary text-white text-center py-2 rounded-xl hover:bg-primary-dark transition">Register</a>
      </div>
    </div>
  </nav>

  <!-- ===== MAIN ===== -->
  <main class="flex-1 flex items-center justify-center pt-24 pb-16 px-4">
    <div class="w-full max-w-5xl animate-fadeUp">
      <div
        class="bg-white rounded-3xl shadow-xl border border-gray-100 overflow-hidden flex flex-col lg:flex-row min-h-[460px]">
        <!-- Left decorative panel -->
        <div class="relative bg-primary lg:w-2/5 flex flex-col justify-between p-10 overflow-hidden">
          <div class="hero-blob w-64 h-64 bg-emerald-300 -top-16 -right-16"></div>
          <div class="hero-blob w-48 h-48 bg-teal-700 bottom-0 -left-12"></div>
          <div class="panel-dots absolute inset-0"></div>

          <div class="relative z-10">
            <div
              class="inline-flex items-center gap-2 bg-white/15 backdrop-blur-sm text-white text-xs font-semibold px-4 py-1.5 rounded-full mb-8">
              <span class="w-2 h-2 rounded-full bg-white animate-pulse inline-block"></span>
              OTP Delivered
            </div>
            <h2 class="font-display text-4xl font-bold text-white leading-tight mb-4">
              Check Your<br />Email<br />Inbox
            </h2>
            <p class="text-green-100 text-sm leading-relaxed max-w-xs">
              We've sent a secure one-time password to your registered email
              address. Use it to complete your password reset.
            </p>
          </div>

          <div class="relative z-10 space-y-3 mt-8">
            <div class="flex items-center gap-3 bg-white/10 rounded-xl px-4 py-3">
              <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <span class="text-white text-xs font-medium">Sent to your registered email</span>
            </div>
            <div class="flex items-center gap-3 bg-white/10 rounded-xl px-4 py-3">
              <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <span class="text-white text-xs font-medium">Valid for 2 minutes only</span>
            </div>
            <div class="flex items-center gap-3 bg-white/10 rounded-xl px-4 py-3">
              <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192L5.636 18.364M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
              </div>
              <span class="text-white text-xs font-medium">Do not share with anyone</span>
            </div>
          </div>
        </div>

        <!-- Right content panel -->
        <div class="flex-1 flex flex-col justify-center px-8 py-10 sm:px-12 animate-fadeUp-d1">
          <div class="mb-8">
            <h3 class="font-display text-3xl font-bold text-gray-900 mb-1">
              Password Reset OTP
            </h3>
            <p class="text-sm text-gray-500">
              Your secure verification code is ready below
            </p>
          </div>

          <!-- OTP display card -->
          <div class="bg-primary-light border border-primary/20 rounded-2xl p-6 mb-6">
            <p class="text-xs font-semibold text-primary uppercase tracking-widest mb-3">
              Your One-Time Password
            </p>
            <div class="otp-code text-4xl font-bold text-primary font-mono mb-2">
              <%= otp_code %>
            </div>
            <div class="flex items-center gap-1.5 mt-3">
              <svg class="w-3.5 h-3.5 text-primary/70" fill="none" stroke="currentColor" stroke-width="2"
                viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="text-xs text-gray-500">Valid for 2 minutes from the time it was sent</span>
            </div>
          </div>

          <!-- Info notice -->
          <div class="bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 mb-6 flex items-start gap-2.5">
            <svg class="w-4 h-4 text-amber-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2"
              viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <p class="text-xs text-amber-700">
              Do not share this OTP with anyone. Satva will never ask for your
              OTP via call or message.
            </p>
          </div>

          <!-- CTA -->
          <a href="/enter-otp-page"
            class="w-full py-3 px-4 bg-primary hover:bg-primary-dark text-white text-sm font-semibold rounded-xl shadow-md transition-all duration-200 flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            Proceed to Reset Password
          </a>

          <p class="text-xs text-gray-400 text-center mt-4">
            If you didn't request this, you can safely ignore this page.
          </p>
        </div>
      </div>
    </div>
  </main>

  <!-- ===== FOOTER ===== -->
  <footer class="bg-[#0f1923] text-gray-400 py-10 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8 pb-8 border-b border-gray-700">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <div class="bg-primary rounded-lg p-1.5">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <span class="text-white font-bold font-display">Satva</span>
        </div>
        <p class="text-xs text-gray-500 leading-relaxed">
          Your trusted partner for quality healthcare, anytime and anywhere.
        </p>
      </div>
      <div>
        <h4 class="text-white text-sm font-semibold mb-3">Quick Links</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/" class="hover:text-primary transition">Home</a></li>
          <li>
            <a href="/doctors" class="hover:text-primary transition">Doctors</a>
          </li>
          <li>
            <a href="/about" class="hover:text-primary transition">About Us</a>
          </li>
          <li>
            <a href="/contact" class="hover:text-primary transition">Contact</a>
          </li>
        </ul>
      </div>
      <div>
        <h4 class="text-white text-sm font-semibold mb-3">Specialties</h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/doctors" class="hover:text-primary transition">Cardiology</a>
          </li>
          <li>
            <a href="/doctors" class="hover:text-primary transition">Neurology</a>
          </li>
          <li>
            <a href="/doctors" class="hover:text-primary transition">Dermatology</a>
          </li>
          <li>
            <a href="/doctors" class="hover:text-primary transition">Pediatrics</a>
          </li>
        </ul>
      </div>
      <div>
        <h4 class="text-white text-sm font-semibold mb-3">Contact</h4>
        <ul class="space-y-2 text-xs">
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2"
              viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            hello@satva.health
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2"
              viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            +91 98765 43210
          </li>
        </ul>
      </div>
    </div>
    <div
      class="max-w-5xl mx-auto pt-6 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-gray-600">
      <p>© 2026 Satva Health. All rights reserved.</p>
      <p>HIPAA Compliant · Secure & Encrypted</p>
    </div>
  </footer>
  <%- include("../error_flash") %>
    <script>
      document.getElementById("menuBtn").addEventListener("click", () => {
        document.getElementById("mobileMenu").classList.toggle("hidden");
      });
    </script>
</body>

</html>