    <script>
      // Mobile menu toggle
      // document.getElementById("menuBtn").addEventListener("click", () => {
      //   document.getElementById("mobileMenu").classList.toggle("hidden");
      // });

      // Password visibility toggle
      const togglePassword = document.getElementById("togglePassword");
      const passwordInput = document.getElementById("password");
      const eyeIcon = document.getElementById("eyeIcon");

      togglePassword.addEventListener("click", () => {
        const isPassword = passwordInput.type === "password";
        passwordInput.type = isPassword ? "text" : "password";
        eyeIcon.className = isPassword
          ? "fa-regular fa-eye-slash text-sm"
          : "fa-regular fa-eye text-sm";
      });
    </script>

    <!--! Validation Script  -->
    <script>
      // Google Auth Token Handler
      const urlParams = new URLSearchParams(window.location.search);
      const urlToken = urlParams.get('token');
      if (urlToken) {
        localStorage.setItem("accessToken", urlToken);
        localStorage.removeItem("is_profile_updated");
        window.history.replaceState({}, document.title, "/login");
        
        // Use the generic check-status endpoint to determine role and redirect
        fetch("/api/v1/auth/check-status", {
          headers: { "Authorization": `Bearer ${urlToken}` }
        })
        .then(res => {
          if (!res.ok) {
            // If token is invalid/expired, clear storage and do nothing.
            localStorage.clear();
            throw new Error('Invalid token');
          }
          return res.json();
        })
        .then(authStatus => {
          const userRole = authStatus.data?.role;
          if (!userRole) {
            localStorage.clear();
            return;
          }

          localStorage.setItem("role", userRole);

          if (userRole === 'PATIENT') {
            // For patients, check if profile is complete before redirecting
            return fetch("/api/v1/patient/profile", {
              headers: { "Authorization": `Bearer ${urlToken}` }
            }).then(res => res.json()).then(profile => {
              if (profile.data && profile.data.isProfileUpdated === false) {
                localStorage.setItem("is_profile_updated", "false");
                window.location.href = "/patient/profile";
              } else {
                localStorage.setItem("is_profile_updated", "true");
                window.location.href = "/patient/dashboard";
              }
            });
          } else {
            // For other roles, redirect directly to their dashboard
            const dashboards = {
              DOCTOR: "/doctor/dashboard",
              STAFF: "/staff/dashboard",
              ADMIN: "/admin/dashboard",
              SUPER_ADMIN: "/super-admin/dashboard"
            };
            window.location.href = dashboards[userRole] || "/login";
          }
        })
        .catch((err) => {
          console.error("Google auth redirect error:", err.message);
          // Fallback: if anything fails, clear storage and user stays on login page.
          localStorage.clear();
        });
      }

      const loginForm = document.getElementById("loginform");
      const email = document.getElementById("email");
      const password = document.getElementById("password");

      const emailError = document.getElementById("emailError");
      const passwordError = document.getElementById("passwordError");

      loginForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        let isValid = true;

        // Reset errors
        emailError.classList.add("hidden");
        passwordError.classList.add("hidden");

        email.classList.remove("border-red-500");
        password.classList.remove("border-red-500");

        // Email validation
        if (!email.value.trim()) {
          emailError.textContent = "Email address is required";
          emailError.classList.remove("hidden");
          email.classList.add("border-red-500");
          isValid = false;
        } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) {
          emailError.textContent = "Please enter a valid email address";
          emailError.classList.remove("hidden");
          email.classList.add("border-red-500");
          isValid = false;
        }

        // Password validation
        if (!password.value.trim()) {
          passwordError.textContent = "Password is required";
          passwordError.classList.remove("hidden");
          password.classList.add("border-red-500");
          isValid = false;
        } else if (password.value.length < 8) {
          passwordError.textContent = "Password must be at least 8 characters";
          passwordError.classList.remove("hidden");
          password.classList.add("border-red-500");
          isValid = false;
        } else if (
          !/^(?=.*?[A-Z])(?=.*?[a-z])(?=.*?[0-9])(?=.*?[#?!@$%^&*-]).{8,}$/.test(
            password.value,
          )
        ) {
          passwordError.textContent =
            "Password shoud contain one lowercase , uppercase , digit and special symbol";
          passwordError.classList.remove("hidden");
          password.classList.add("border-red-500");
          isValid = false;
        }

        if (!isValid) {
          e.preventDefault();
        } else {
          try {
            const response = await fetch("/api/v1/auth/login", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              credentials: "include",
              body: JSON.stringify({
                email: email.value.trim(),
                password: password.value,
              }),
            });

            const resp = await response.json();
            if (!response.ok) {
              alert(data.message);
              return;
            }
            console.log(resp)
            const data = resp.data;
            const user = data.user;
            const role = user.role;
            const token = data.accessToken;
            localStorage.setItem("accessToken", token);
            if(role === 'PATIENT'){
              localStorage.setItem("role", role);
              window.location.href = "/patient/dashboard";
            }else if(role === 'DOCTOR'){
              localStorage.setItem("role", role);
              window.location.href = "/doctor/dashboard";
            }else if(role === 'STAFF'){
              localStorage.setItem("role",role);
              window.location.href = "/staff/doctors"
            }
          }
          catch (error) {
            console.error(error);
            alert("Something went wrong");
          }
        }
      });
    </script>
